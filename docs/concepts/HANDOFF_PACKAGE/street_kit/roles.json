{
 "about": "REBEL_CELL street kit: every street_r2 prop at default size, one glb each. Built by scripts/export_kit.py from the plate scripts.",
 "conventions": {
  "units": "1 BU = 1 metre",
  "up": "+Y (glTF)",
  "wall": "wall props: the wall surface is the XY plane at z = 0, the wall runs along +X, the prop sticks out toward +Z; recess geometry (balcony door, setback slab) goes to -Z",
  "ground": "ground/roof props stand on y = 0",
  "vertex_colour": "COLOR_0 = authored plate colour per face, unmodified (display-referred sRGB values, as the toon shader showed them); set vertex_color_is_srgb in Godot",
  "material_roles": "slot names are roles; emissive roles end in _emit and carry emissive colour = authored colour, strength 1.0; an emissive role with several colours gets role_2, role_3 slots",
  "sizes": "random-sized props use the midpoint of the plate rule's range; ranges are quoted in the source notes",
  "double_sided": "all materials are double sided (the plate rules do not wind every face consistently)"
 },
