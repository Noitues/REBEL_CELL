{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "city.json v1 (NA02_FIELDS.md section 2)",
 "version": 1,
 "type": "object",
 "required": ["version", "layout_seed", "units", "lot_bu", "origin_lot", "buildings", "streets", "plazas", "hqs", "hq_overlaps"],
 "additionalProperties": false,
 "properties": {
  "version": {"const": 1},
  "layout_seed": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
  "units": {"const": "BU"},
  "lot_bu": {"type": "number"},
  "origin_lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
  "buildings": {
   "type": "array",
   "x-unique-by": "bid",
   "items": {
    "type": "object",
    "required": ["bid", "cell", "terr", "hq", "key", "parts"],
    "additionalProperties": false,
    "properties": {
     "bid": {"type": "string", "pattern": "^(-?[0-9]+:-?[0-9]+|hq:[a-z0-9_]+)$"},
     "cell": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
     "terr": {"type": "string"},
     "hq": {"type": "boolean"},
     "key": {"type": "integer"},
     "ground": {"type": "number", "description": "CITY-A2 step 2 (optional): the ground (BU) the building stands on; its parts' z0 are above it"},
     "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": ["poly", "z0", "h", "taper"],
       "additionalProperties": false,
       "properties": {
        "poly": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "z0": {"type": "number"},
        "h": {"type": "number"},
        "taper": {"type": "number"}
       }
      }
     }
    }
   }
  },
  "streets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["lot", "along_i", "along_j", "traffic"],
    "additionalProperties": false,
    "properties": {
     "lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
     "along_i": {"type": "boolean"},
     "along_j": {"type": "boolean"},
     "traffic": {"type": "number"}
    }
   }
  },
  "plazas": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["lot", "terr"],
    "additionalProperties": false,
    "properties": {
     "lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
     "terr": {"type": "string"}
    }
   }
  },
  "hq_overlaps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["bid", "corp"],
    "additionalProperties": false,
    "properties": {"bid": {"type": "string"}, "corp": {"type": "string"}}
   }
  },
  "hqs": {
   "type": "object",
   "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
  },
  "coast": {
   "type": "object",
   "required": ["sea_side", "shoreline", "sea_cells"],
   "additionalProperties": false,
   "properties": {
    "sea_side": {"enum": ["N", "E", "S", "W"]},
    "shoreline": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}},
    "sea_cells": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}}
   }
  },
  "solace_park": {
   "description": "Solace district layout (A-069 / A-070, optional): the one park that replaces the Solace street grid. Plan BU (x east, y north); lots as [i, j]. The building footprints are the district's `buildings` (blocks of 2-3 lots).",
   "type": "object",
   "required": ["outline", "paths", "ponds", "lots", "plinth"],
   "additionalProperties": false,
   "properties": {
    "outline": {
     "description": "The park region's organic boundary: loops of plan BU points (closed, last point not repeated); the largest is the outer boundary, `hole` loops are cut out of it. The region holds the lawn, the blocks, the Site lots and the HQ plaza; border streets and A2 roads are outside it.",
     "type": "array",
     "items": {
      "type": "object",
      "required": ["hole", "points"],
      "additionalProperties": false,
      "properties": {"hole": {"type": "boolean"}, "points": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}}
     }
    },
    "paths": {
     "description": "Polylines of plan BU points. kind stair: from a plinth stair landing out to a city street; path: a winding walk from a city street to the network; lane: a curved service lane from one city street to another. `width` in BU. Both ends of a path or lane that meets the district edge stand on the centre of the street lot beside the park.",
     "type": "array",
     "items": {
      "type": "object",
      "required": ["id", "kind", "width", "points"],
      "additionalProperties": false,
      "properties": {
       "id": {"type": "string"},
       "kind": {"enum": ["stair", "path", "lane"]},
       "width": {"type": "number"},
       "points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
      }
     }
    },
    "ponds": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["centre", "points"],
      "additionalProperties": false,
      "properties": {
       "centre": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
       "points": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
      }
     }
    },
    "lots": {"description": "The lawn lots (no building, no street), row order", "type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}},
    "plinth": {
     "description": "The HQ plinth: a circle of `radius` BU (outer radius, 35) round `centre`; stairs at world N / E / S / W land at `landing` (on the circle) on the path `path` (its id, '' when none was routable)",
     "type": "object",
     "required": ["centre", "radius", "stairs"],
     "additionalProperties": false,
     "properties": {
      "centre": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
      "radius": {"type": "number"},
      "stairs": {
       "type": "array",
       "items": {
        "type": "object",
        "required": ["dir", "landing", "path"],
        "additionalProperties": false,
        "properties": {
         "dir": {"enum": ["N", "E", "S", "W"]},
         "landing": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
         "path": {"type": "string"}
        }
       }
      }
     }
    }
   }
  },
  "terrain": {
   "type": "object",
   "required": ["hills"],
   "additionalProperties": false,
   "properties": {
    "hills": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["centre", "sigma_x", "sigma_y", "height", "rotation"],
      "additionalProperties": false,
      "properties": {
       "centre": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
       "sigma_x": {"type": "number"},
       "sigma_y": {"type": "number"},
       "height": {"type": "number"},
       "rotation": {"type": "number"}
      }
     }
    },
    "heights": {
     "description": "CITY-A2 step 2 (optional): the ground (BU) at every lot corner of the city rect; rows[r][c] at plan point origin + (c, -r) x step",
     "type": "object",
     "required": ["origin", "step", "size", "rows"],
     "additionalProperties": false,
     "properties": {
      "origin": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
      "step": {"type": "number"},
      "size": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
      "rows": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}}
     }
    }
   }
  }
 }
}
