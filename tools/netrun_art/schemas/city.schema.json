{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "city.json v1 (NA02_FIELDS.md section 2)",
 "version": 1,
 "type": "object",
 "required": ["version", "layout_seed", "units", "lot_bu", "origin_lot", "buildings", "streets", "plazas", "hqs", "hq_overlaps"],
 "additionalProperties": false,
 "properties": {
  "version": {"const": 1},
  "layout_seed": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
  "units": {"const": "BU"},
  "lot_bu": {"type": "number"},
  "origin_lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
  "buildings": {
   "type": "array",
   "x-unique-by": "bid",
   "items": {
    "type": "object",
    "required": ["bid", "cell", "terr", "hq", "key", "parts"],
    "additionalProperties": false,
    "properties": {
     "bid": {"type": "string", "pattern": "^(-?[0-9]+:-?[0-9]+|hq:[a-z0-9_]+)$"},
     "cell": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
     "terr": {"type": "string"},
     "hq": {"type": "boolean"},
     "key": {"type": "integer"},
     "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": ["poly", "z0", "h", "taper"],
       "additionalProperties": false,
       "properties": {
        "poly": {"type": "array", "minItems": 3, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
        "z0": {"type": "number"},
        "h": {"type": "number"},
        "taper": {"type": "number"}
       }
      }
     }
    }
   }
  },
  "streets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["lot", "along_i", "along_j", "traffic"],
    "additionalProperties": false,
    "properties": {
     "lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
     "along_i": {"type": "boolean"},
     "along_j": {"type": "boolean"},
     "traffic": {"type": "number"}
    }
   }
  },
  "plazas": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["lot", "terr"],
    "additionalProperties": false,
    "properties": {
     "lot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
     "terr": {"type": "string"}
    }
   }
  },
  "hq_overlaps": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["bid", "corp"],
    "additionalProperties": false,
    "properties": {"bid": {"type": "string"}, "corp": {"type": "string"}}
   }
  },
  "hqs": {
   "type": "object",
   "additionalProperties": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
  },
  "coast": {
   "type": "object",
   "required": ["sea_side", "shoreline", "sea_cells"],
   "additionalProperties": false,
   "properties": {
    "sea_side": {"enum": ["N", "E", "S", "W"]},
    "shoreline": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}},
    "sea_cells": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}}
   }
  },
  "terrain": {
   "type": "object",
   "required": ["hills"],
   "additionalProperties": false,
   "properties": {
    "hills": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["centre", "sigma_x", "sigma_y", "height", "rotation"],
      "additionalProperties": false,
      "properties": {
       "centre": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
       "sigma_x": {"type": "number"},
       "sigma_y": {"type": "number"},
       "height": {"type": "number"},
       "rotation": {"type": "number"}
      }
     }
    }
   }
  }
 }
}
