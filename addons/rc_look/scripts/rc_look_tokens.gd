class_name RcLookTokens
extends Resource
## LOOK-TOOLBOX module 1 (ART_BIBLE §2): the colour tokens every rc_look shader reads as a global uniform. `Palette`
## stays the one source of the values; this resource only says which Palette tokens become shader globals and under
## what name. `addons/rc_look/tools/sync_tokens.gd` writes them into project.godot [shader_globals] and declares them
## in `addons/rc_look/shaders/rc_tokens.gdshaderinc`; `test_rc_look_tokens.gd` fails when either drifts from Palette.

## The default token set.
const DEFAULT_PATH := "res://addons/rc_look/config/look_tokens.tres"
## Every shader global this resource owns starts with this prefix (project.godot keeps other globals, e.g.
## `reduce_effects`).
const PREFIX := "rc_"

## Palette path -> shader global name (without PREFIX). A path is a Palette constant (`CELL_PINK`) or a key of a
## Palette dictionary constant (`CLASS_ACCENTS.breaker`).
@export var globals: Dictionary = {}


## The Palette colour at `path` (`CONST` or `DICT_CONST.key`), or null when there is none or it is not a Color.
static func resolve(path: String) -> Variant:
	var consts: Dictionary = (Palette as Script).get_script_constant_map()
	var parts := path.split(".", false, 1)
	if parts.is_empty() or not consts.has(parts[0]):
		return null
	var v: Variant = consts[parts[0]]
	if parts.size() == 2:
		if not (v is Dictionary):
			return null
		v = (v as Dictionary).get(StringName(parts[1]), null)
	return v if v is Color else null


## The full shader global name of the entry `name` (PREFIX + name).
static func global_name(name: String) -> String:
	return PREFIX + name


## Shader global name -> its Palette colour, in a stable order (sorted by global name).
func values() -> Dictionary:
	var names: Array = globals.values()
	names.sort()
	var by_name := {}
	for path: String in globals:
		by_name[String(globals[path])] = path
	var out := {}
	for n: String in names:
		out[global_name(n)] = resolve(String(by_name[n]))
	return out


## Problems with the set: a path that resolves to no Palette colour, a name used twice, a name that is not a lower
## snake_case identifier. Empty when the set is good.
func validate() -> PackedStringArray:
	var errs := PackedStringArray()
	var seen := {}
	var ident := RegEx.create_from_string("^[a-z][a-z0-9_]*$")
	for path: String in globals:
		var n := String(globals[path])
		if resolve(path) == null:
			errs.append("%s: no Palette colour" % path)
		if ident.search(n) == null:
			errs.append("%s: '%s' is not a lower snake_case name" % [path, n])
		if seen.has(n):
			errs.append("%s: name '%s' also used by %s" % [path, n, seen[n]])
		seen[n] = path
	return errs


## The include that declares every global (generated; sync_tokens.gd writes it).
func include_source() -> String:
	var lines := PackedStringArray([
		"// GENERATED by addons/rc_look/tools/sync_tokens.gd from addons/rc_look/config/look_tokens.tres. Do not edit.",
		"// LOOK-TOOLBOX module 1: the ART_BIBLE §2 tokens as global uniforms (values: Palette, via project.godot).",
		"#ifndef RC_TOKENS_INCLUDED",
		"#define RC_TOKENS_INCLUDED",
	])
	for n: String in values():
		lines.append("global uniform vec4 %s;" % n)
	lines.append("#endif")
	return "\n".join(lines) + "\n"
