key = "bark:defeat"
text = "Power's out. Tell the Cell the rig was good."

[sub_resource type="Resource" id="l6"]
script = ExtResource("e1")
key = "bark:deploy"
text = "Deploying? That's the Botnet's job."

[sub_resource type="Resource" id="l7"]
