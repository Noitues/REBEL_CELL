[gd_resource type="Resource" script_class="LineSetData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/line_set_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/voice_line_data.gd" id="e1"]

; Pirate-radio DJ lines (HQ). Horizontal pass 1: split per corporation.

[sub_resource type="Resource" id="l0"]
script = ExtResource("e1")
key = "dj"
text = "You are listening to nobody, on no frequency, from nowhere. Stay unlicensed."

[sub_resource type="Resource" id="l1"]
script = ExtResource("e1")
key = "dj"
text = "Whoever is running the Cell tonight: your handler is fast. Faster than a person. Just saying."

[sub_resource type="Resource" id="l2"]
script = ExtResource("e1")
key = "dj"
text = "The voice giving the orders in the district does not breathe between sentences. I have the tapes."

[resource]
script = ExtResource("main_script")
id = &"dj_hq"
speaker = 0
lines = Array[ExtResource("e1")]([SubResource("l0"), SubResource("l1"), SubResource("l2")])
