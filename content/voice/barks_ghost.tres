[gd_resource type="Resource" script_class="LineSetData" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/data/line_set_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/voice_line_data.gd" id="e1"]

[sub_resource type="Resource" id="l0"]
script = ExtResource("e1")
key = "bark:perfect"
text = "Clean. They never saw the wheel move."

[sub_resource type="Resource" id="l1"]
script = ExtResource("e1")
key = "bark:perfect"
text = "Perfect. Resistance is a rumour."

[sub_resource type="Resource" id="l2"]
script = ExtResource("e1")
key = "bark:miss"
text = "Miss. Stay quiet, reset, try again."

[sub_resource type="Resource" id="l3"]
script = ExtResource("e1")
key = "bark:hurt"
text = "Grazed. Nothing they can trace."

[sub_resource type="Resource" id="l4"]
script = ExtResource("e1")
key = "bark:victory"
text = "Gone before the log catches up."

[sub_resource type="Resource" id="l5"]
script = ExtResource("e1")
key = "bark:defeat"
text = "They saw me. First time for everything."

[sub_resource type="Resource" id="l6"]
script = ExtResource("e1")
key = "bark:deploy"
text = "No drones. I prefer to be alone in here."

[sub_resource type="Resource" id="l7"]
script = ExtResource("e1")
key = "bark:jack_in"
text = "Ghosting in. Leave no footprints."

[sub_resource type="Resource" id="l8"]
script = ExtResource("e1")
key = "bark:boss"
text = "Big wheel, bigger blind spots."

[resource]
script = ExtResource("main_script")
id = &"barks_ghost"
speaker = 1
class_id = &"ghost"
lines = Array[ExtResource("e1")]([SubResource("l0"), SubResource("l1"), SubResource("l2"), SubResource("l3"), SubResource("l4"), SubResource("l5"), SubResource("l6"), SubResource("l7"), SubResource("l8")])
