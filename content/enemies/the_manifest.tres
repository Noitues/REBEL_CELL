; The Manifest, Meridian final boss (M8, decision 2026-09-24). 400 HP; hub Priority
; Routing gains 4 shield per turn unless breached; 66%: Multiply (0, 15); 33%: Orbit 2, Crit wheel, 2 courier drones.

[sub_resource type="Resource" id="fx_shield"]
script = ExtResource("e1")
type = 2
target = 0
amount = 4

[sub_resource type="Resource" id="te_priority"]
script = ExtResource("e2")
trigger = 2
effects = Array[ExtResource("e1")]([SubResource("fx_shield")])

[sub_resource type="Resource" id="hub_priority"]
script = ExtResource("e3")
id = &"priority_routing"
display_name = "Priority Routing"
description = "Gains 4 shield each turn unless the Hub is breached."
passive_effects = Array[ExtResource("e2")]([SubResource("te_priority")])

[sub_resource type="Resource" id="wheel_slot_atk_14"]
script = ExtResource("e5")
slice = ExtResource("e4")

[sub_resource type="Resource" id="wheel_slot_tariff"]
script = ExtResource("e5")
slice = ExtResource("e6")

[sub_resource type="Resource" id="wheel_slot_def_12"]
