slots = Array[ExtResource("e5")]([SubResource("wheel_phase1_slot_crit_24"), SubResource("wheel_phase1_slot_tariff"), SubResource("wheel_phase1_slot_def_12"), SubResource("wheel_phase1_slot_crit_24"), SubResource("wheel_phase1_slot_atk_14"), SubResource("wheel_phase1_slot_miss")])
