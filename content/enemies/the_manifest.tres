[sub_resource type="Resource" id="pspawn1_0"]
script = ExtResource("e12")
satellite = ExtResource("e13")
trigger = 1
every_n = 1
dock_slot = -1
max_active = 2

[sub_resource type="Resource" id="phase1"]
script = ExtResource("e11")
hp_threshold_pct = 0.33
pointer_behavior = 3
pointer_ticks = PackedInt32Array(0, 15)
orbit_ticks_per_turn = 2
wheel_override = SubResource("wheel_phase1")
spawns = Array[ExtResource("e12")]([SubResource("pspawn1_0")])
phase_line = "Peak season: the heads drift, the couriers launch, the second lane goes critical."

[resource]
script = ExtResource("main_script")
id = &"the_manifest"
display_name = "The Manifest"
description = "Meridian's routing core. Every package on the planet passes through it."
corporation_id = &"meridian"
hp = 400
wheel = SubResource("wheel")
is_boss = true
cycle_reward = 0
phases = Array[ExtResource("e11")]([SubResource("phase0"), SubResource("phase1")])
