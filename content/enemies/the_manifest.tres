slice = ExtResource("e7")

[sub_resource type="Resource" id="wheel_slot_crit_24"]
script = ExtResource("e5")
slice = ExtResource("e8")

[sub_resource type="Resource" id="wheel_slot_miss"]
script = ExtResource("e5")
slice = ExtResource("e9")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("e10")
slice_count = 6
slots = Array[ExtResource("e5")]([SubResource("wheel_slot_atk_14"), SubResource("wheel_slot_tariff"), SubResource("wheel_slot_def_12"), SubResource("wheel_slot_crit_24"), SubResource("wheel_slot_atk_14"), SubResource("wheel_slot_miss")])
hub = SubResource("hub_priority")
pointer_ticks = PackedInt32Array(0)

[sub_resource type="Resource" id="phase0"]
script = ExtResource("e11")
hp_threshold_pct = 0.66
pointer_behavior = 1
pointer_ticks = PackedInt32Array(0, 15)
phase_line = "Load balancing: a second routing head comes online."

[sub_resource type="Resource" id="wheel_phase1_slot_crit_24"]
script = ExtResource("e5")
slice = ExtResource("e8")

[sub_resource type="Resource" id="wheel_phase1_slot_tariff"]
script = ExtResource("e5")
