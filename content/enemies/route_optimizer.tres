[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="e2"]
[ext_resource type="Resource" path="res://content/slices/crit_14.tres" id="e3"]
[ext_resource type="Resource" path="res://content/slices/def_5.tres" id="e4"]
[ext_resource type="Resource" path="res://content/slices/miss.tres" id="e5"]
