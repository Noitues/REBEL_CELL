; Meridian Freight Systems enemy (M8, decision 2026-09-24).

[sub_resource type="Resource" id="wheel_slot_atk_8"]
script = ExtResource("e2")
slice = ExtResource("e1")

[sub_resource type="Resource" id="wheel_slot_crit_14"]
script = ExtResource("e2")
slice = ExtResource("e3")

[sub_resource type="Resource" id="wheel_slot_def_5"]
script = ExtResource("e2")
slice = ExtResource("e4")

[sub_resource type="Resource" id="wheel_slot_miss"]
script = ExtResource("e2")
slice = ExtResource("e5")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("e6")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_crit_14"), SubResource("wheel_slot_def_5"), SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_miss")])
pointer_ticks = PackedInt32Array(0, 15)

[resource]
script = ExtResource("main_script")
id = &"route_optimizer"
display_name = "Route Optimizer"
description = "Reads two routes at once: pointers at ticks 0 and 15."
corporation_id = &"meridian"
hp = 48
wheel = SubResource("wheel")
cycle_reward = 15
