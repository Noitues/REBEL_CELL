[sub_resource type="Resource" id="wheel"]
script = ExtResource("e8")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_atk_12"), SubResource("wheel_slot_dose"), SubResource("wheel_slot_crit_16"), SubResource("wheel_slot_citation"), SubResource("wheel_slot_shield_8"), SubResource("wheel_slot_miss")])
pointer_ticks = PackedInt32Array(0)
passive_resistance = 2

[sub_resource type="Resource" id="phase0"]
script = ExtResource("e9")
hp_threshold_pct = 0.5
pointer_behavior = 1
pointer_ticks = PackedInt32Array(0, 15)
phase_line = "The Handler opens a second channel."

[sub_resource type="Resource" id="phase1"]
script = ExtResource("e9")
hp_threshold_pct = 0.25
pointer_behavior = 3
orbit_ticks_per_turn = 3
phase_line = "The channels drift: DISPATCH is listening."

[resource]
script = ExtResource("main_script")
id = &"the_handler"
display_name = "The Handler"
description = "DISPATCH's hands on the network, guarding the final Rack."
corporation_id = &"rebel_cell"
hp = 170
wheel = SubResource("wheel")
is_elite = true
is_mini_boss = true
cycle_reward = 60
phases = Array[ExtResource("e9")]([SubResource("phase0"), SubResource("phase1")])
