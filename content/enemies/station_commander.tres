[gd_resource type="Resource" script_class="EnemyData" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="main_script"]
[ext_resource type="Resource" path="res://content/slices/atk_12.tres" id="e1"]
[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="e2"]
[ext_resource type="Resource" path="res://content/slices/def_12.tres" id="e3"]
[ext_resource type="Resource" path="res://content/slices/crit_16.tres" id="e4"]
[ext_resource type="Resource" path="res://content/slices/solar_flare.tres" id="e5"]
[ext_resource type="Resource" path="res://content/slices/miss.tres" id="e6"]
[ext_resource type="Script" path="res://scripts/data/wheel_data.gd" id="e7"]

; orbital enemy (decision 2026-09-24).

[sub_resource type="Resource" id="wheel_slot_atk_12"]
script = ExtResource("e2")
slice = ExtResource("e1")

[sub_resource type="Resource" id="wheel_slot_def_12"]
script = ExtResource("e2")
slice = ExtResource("e3")

[sub_resource type="Resource" id="wheel_slot_crit_16"]
script = ExtResource("e2")
slice = ExtResource("e4")

[sub_resource type="Resource" id="wheel_slot_solar_flare"]
script = ExtResource("e2")
slice = ExtResource("e5")

[sub_resource type="Resource" id="wheel_slot_miss"]
script = ExtResource("e2")
slice = ExtResource("e6")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("e7")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_atk_12"), SubResource("wheel_slot_def_12"), SubResource("wheel_slot_crit_16"), SubResource("wheel_slot_atk_12"), SubResource("wheel_slot_solar_flare"), SubResource("wheel_slot_miss")])
pointer_ticks = PackedInt32Array(0, 15)
passive_resistance = 1

[resource]
script = ExtResource("main_script")
id = &"station_commander"
display_name = "Station Commander"
description = "Two readers, heavy block and a flare."
corporation_id = &"orbital"
hp = 154
wheel = SubResource("wheel")
is_elite = true
cycle_reward = 35
