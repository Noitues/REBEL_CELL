[gd_resource type="Resource" script_class="EnemyData" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/wheel_data.gd" id="2"]
[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="3"]
[ext_resource type="Resource" path="res://content/slices/shim_7.tres" id="s_atk"]
[ext_resource type="Resource" path="res://content/slices/defrag_6.tres" id="s_def"]
[ext_resource type="Resource" path="res://content/slices/overflow_12.tres" id="s_crit"]
[ext_resource type="Resource" path="res://content/slices/miss.tres" id="s_miss"]
[ext_resource type="Resource" path="res://content/hub_cores/compliance_lock.tres" id="hub"]
[ext_resource type="Script" path="res://scripts/data/heat_gated_effect_data.gd" id="hg"]
[ext_resource type="Script" path="res://scripts/data/triggered_effect_data.gd" id="te"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="fx"]

; Compliance Officer (GDD A.3): 50 HP; Shim 7, Shim 7, Defrag 6, Overflow 12, Shim 7, Miss;
; Hub Compliance Lock (resistance 3). Heat 50+: "Audit" - each of its attacks also
; drains 1 RAM (HeatGatedEffectData; trigger 5 ON_SLICE_TRIGGER, effect 13 DRAIN_RAM on
; POINTER_TARGET 3).

[sub_resource type="Resource" id="fx_audit"]
script = ExtResource("fx")
type = 13
target = 3
amount = 1

[sub_resource type="Resource" id="te_audit"]
script = ExtResource("te")
trigger = 5
effects = Array[ExtResource("fx")]([SubResource("fx_audit")])

[sub_resource type="Resource" id="heat_audit"]
script = ExtResource("hg")
min_heat = 50
offensive_slices_only = true
effects = Array[ExtResource("te")]([SubResource("te_audit")])

[sub_resource type="Resource" id="slot_atk"]
script = ExtResource("3")
slice = ExtResource("s_atk")

[sub_resource type="Resource" id="slot_def"]
script = ExtResource("3")
slice = ExtResource("s_def")

[sub_resource type="Resource" id="slot_crit"]
script = ExtResource("3")
slice = ExtResource("s_crit")

[sub_resource type="Resource" id="slot_miss"]
script = ExtResource("3")
slice = ExtResource("s_miss")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("2")
slice_count = 6
slots = Array[ExtResource("3")]([SubResource("slot_atk"), SubResource("slot_atk"), SubResource("slot_def"), SubResource("slot_crit"), SubResource("slot_atk"), SubResource("slot_miss")])
hub = ExtResource("hub")
pointer_ticks = PackedInt32Array(0)

[resource]
script = ExtResource("1")
id = &"compliance_officer"
display_name = "Compliance Officer"
description = "Locks its wheel down with Hub-sourced resistance."
corporation_id = &"solace"
hp = 50
wheel = SubResource("wheel")
cycle_reward = 15
heat_effects = Array[ExtResource("hg")]([SubResource("heat_audit")])
