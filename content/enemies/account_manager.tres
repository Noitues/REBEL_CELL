[gd_resource type="Resource" script_class="EnemyData" load_steps=22 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/wheel_data.gd" id="2"]
[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="3"]
[ext_resource type="Script" path="res://scripts/data/boss_phase_data.gd" id="4"]
[ext_resource type="Resource" path="res://content/slices/atk_10.tres" id="s_atk"]
[ext_resource type="Resource" path="res://content/slices/def_8.tres" id="s_def"]
[ext_resource type="Resource" path="res://content/slices/crit_16.tres" id="s_crit"]
[ext_resource type="Resource" path="res://content/slices/dose.tres" id="s_dose"]
[ext_resource type="Resource" path="res://content/slices/shield_5.tres" id="s_shield"]
[ext_resource type="Resource" path="res://content/slices/miss.tres" id="s_miss"]
[ext_resource type="Script" path="res://scripts/data/heat_gated_effect_data.gd" id="hg"]
[ext_resource type="Script" path="res://scripts/data/triggered_effect_data.gd" id="te"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="fx"]

; Account Manager, Solace mini-boss (designer ruling 2026-09-24): guards the final Server
; Rack of every netrun; scales with the tier like everything else. 120 HP; Atk 10, Def 8,
; Crit 16, Dose, Shield 5, Miss; passive resistance 1; at 50% HP multiplies to two
; pointers (0 and 15): MULTIPLY at 50%, then at 25% the pointers MIGRATE (telegraphed a
; turn ahead, GDD 2.11) to 5 and 20 so the wheel reads off-centre slices. Heat 75+:
; "Retainer" heals 5 at each start of turn. Numbers are placeholders for playtest.

[sub_resource type="Resource" id="fx_retainer"]
script = ExtResource("fx")
type = 14
target = 0
amount = 5

[sub_resource type="Resource" id="te_retainer"]
script = ExtResource("te")
trigger = 2
effects = Array[ExtResource("fx")]([SubResource("fx_retainer")])

[sub_resource type="Resource" id="heat_retainer"]
script = ExtResource("hg")
min_heat = 75
effects = Array[ExtResource("te")]([SubResource("te_retainer")])

[sub_resource type="Resource" id="slot_atk"]
script = ExtResource("3")
slice = ExtResource("s_atk")

[sub_resource type="Resource" id="slot_def"]
script = ExtResource("3")
slice = ExtResource("s_def")

[sub_resource type="Resource" id="slot_crit"]
script = ExtResource("3")
slice = ExtResource("s_crit")

[sub_resource type="Resource" id="slot_dose"]
script = ExtResource("3")
slice = ExtResource("s_dose")

[sub_resource type="Resource" id="slot_shield"]
script = ExtResource("3")
slice = ExtResource("s_shield")

[sub_resource type="Resource" id="slot_miss"]
script = ExtResource("3")
slice = ExtResource("s_miss")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("2")
slice_count = 6
slots = Array[ExtResource("3")]([SubResource("slot_atk"), SubResource("slot_def"), SubResource("slot_crit"), SubResource("slot_dose"), SubResource("slot_shield"), SubResource("slot_miss")])
pointer_ticks = PackedInt32Array(0)
passive_resistance = 1

[sub_resource type="Resource" id="phase_escalate"]
script = ExtResource("4")
hp_threshold_pct = 0.5
pointer_behavior = 1
pointer_ticks = PackedInt32Array(0, 15)
phase_line = "Escalation: the account is flagged for review by two readers."

[sub_resource type="Resource" id="phase_migrate"]
script = ExtResource("4")
hp_threshold_pct = 0.25
pointer_behavior = 2
pointer_ticks = PackedInt32Array(5, 20)
phase_line = "Final notice: the readers drift off-centre."

[resource]
script = ExtResource("1")
id = &"account_manager"
display_name = "Account Manager"
description = "The senior process guarding the Server Rack. Escalates at half health."
corporation_id = &"solace"
hp = 120
wheel = SubResource("wheel")
is_elite = true
is_mini_boss = true
cycle_reward = 60
phases = Array[ExtResource("4")]([SubResource("phase_escalate"), SubResource("phase_migrate")])
heat_effects = Array[ExtResource("hg")]([SubResource("heat_retainer")])
