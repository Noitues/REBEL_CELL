[gd_resource type="Resource" script_class="EnemyData" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="main_script"]
[ext_resource type="Resource" path="res://content/slices/defrag_8.tres" id="e1"]
[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="e2"]
[ext_resource type="Resource" path="res://content/slices/shim_10.tres" id="e3"]
[ext_resource type="Resource" path="res://content/slices/shim_8_weight.tres" id="e4"]
[ext_resource type="Resource" path="res://content/slices/sandbox_5.tres" id="e5"]
[ext_resource type="Resource" path="res://content/slices/null.tres" id="e6"]
[ext_resource type="Script" path="res://scripts/data/wheel_data.gd" id="e7"]

; Meridian Freight Systems enemy (M8, decision 2026-09-24).

[sub_resource type="Resource" id="wheel_slot_defrag_8"]
script = ExtResource("e2")
slice = ExtResource("e1")

[sub_resource type="Resource" id="wheel_slot_shim_10"]
script = ExtResource("e2")
slice = ExtResource("e3")

[sub_resource type="Resource" id="wheel_slot_shim_8_weight"]
script = ExtResource("e2")
slice = ExtResource("e4")

[sub_resource type="Resource" id="wheel_slot_sandbox_5"]
script = ExtResource("e2")
slice = ExtResource("e5")

[sub_resource type="Resource" id="wheel_slot_null"]
script = ExtResource("e2")
slice = ExtResource("e6")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("e7")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_defrag_8"), SubResource("wheel_slot_shim_10"), SubResource("wheel_slot_defrag_8"), SubResource("wheel_slot_shim_8_weight"), SubResource("wheel_slot_sandbox_5"), SubResource("wheel_slot_null")])
pointer_ticks = PackedInt32Array(0)
passive_resistance = 2

[resource]
script = ExtResource("main_script")
id = &"cargo_hauler"
display_name = "Cargo Hauler"
description = "Slow, heavy and hard to turn: its weight resists every nudge."
corporation_id = &"meridian"
hp = 72
wheel = SubResource("wheel")
cycle_reward = 15
