[gd_resource type="Resource" script_class="EnemyData" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/data/enemy_data.gd" id="main_script"]
[ext_resource type="Resource" path="res://content/slices/atk_9.tres" id="e1"]
[ext_resource type="Script" path="res://scripts/data/wheel_slot_data.gd" id="e2"]
[ext_resource type="Resource" path="res://content/slices/citation.tres" id="e3"]
[ext_resource type="Resource" path="res://content/slices/def_6.tres" id="e4"]
[ext_resource type="Resource" path="res://content/slices/crit_14.tres" id="e5"]
[ext_resource type="Resource" path="res://content/slices/miss.tres" id="e6"]
[ext_resource type="Script" path="res://scripts/data/wheel_data.gd" id="e7"]

; halcyon enemy (decision 2026-09-24).

[sub_resource type="Resource" id="wheel_slot_atk_9"]
script = ExtResource("e2")
slice = ExtResource("e1")

[sub_resource type="Resource" id="wheel_slot_citation"]
script = ExtResource("e2")
slice = ExtResource("e3")

[sub_resource type="Resource" id="wheel_slot_def_6"]
script = ExtResource("e2")
slice = ExtResource("e4")

[sub_resource type="Resource" id="wheel_slot_crit_14"]
script = ExtResource("e2")
slice = ExtResource("e5")

[sub_resource type="Resource" id="wheel_slot_miss"]
script = ExtResource("e2")
slice = ExtResource("e6")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("e7")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_atk_9"), SubResource("wheel_slot_citation"), SubResource("wheel_slot_def_6"), SubResource("wheel_slot_crit_14"), SubResource("wheel_slot_atk_9"), SubResource("wheel_slot_miss")])
pointer_ticks = PackedInt32Array(0)

[resource]
script = ExtResource("main_script")
id = &"parking_warden"
display_name = "Parking Warden"
description = "Writes Citations: your slice runs at half until you cleanse it."
corporation_id = &"halcyon"
hp = 48
wheel = SubResource("wheel")
cycle_reward = 15
