[sub_resource type="Resource" id="wheel"]
script = ExtResource("e6")
slice_count = 6
slots = Array[ExtResource("e2")]([SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_def_6"), SubResource("wheel_slot_crit_14"), SubResource("wheel_slot_atk_8"), SubResource("wheel_slot_miss")])
pointer_ticks = PackedInt32Array(0, 15)
pointer_orbit_per_turn = 1

[resource]
script = ExtResource("main_script")
id = &"transit_controller"
display_name = "Transit Controller"
description = "Two readers on a slow loop: pointers 0 and 15 orbit 1 a turn."
corporation_id = &"halcyon"
hp = 50
wheel = SubResource("wheel")
