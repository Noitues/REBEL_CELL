; 7 RAID_EXTRA_WAVE, 8 ENEMY_RESISTANCE, 9 DEATH_HEAT, 10 EXPLOIT_HEAT,
; 11 BOSS_PHASE_EARLY, 12 BOSS_EXTRA_POINTER, 13 STARTING_BUG_CARD,
; 14 NO_FIRST_TURN_FREE_NUDGE, 15 REPAIR_COST_PCT, 16 SEIZED_RAID_STRENGTH_PCT,
; 17 PURGE_THRESHOLD

