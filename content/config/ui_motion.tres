[gd_resource type="Resource" script_class="UiMotionData" load_steps=75 format=3]

[ext_resource type="Script" path="res://scripts/data/ui_motion_data.gd" id="1_motion"]
[ext_resource type="Script" path="res://scripts/data/ui_motion_entry_data.gd" id="1_entry"]

; UI motion (ANIMATION_HANDOFF 3-4, STYLE_GUIDE 5): every animation's timing, read by
; the Motion kit by id. Tune in tools/design_lab/motion_lab.tscn and paste lines back.
; ease: 0 IN, 1 OUT, 2 IN_OUT, 3 OUT_IN. trans: 0 LINEAR, 1 SINE, 2 QUINT, 3 QUART,
; 4 QUAD, 5 EXPO, 6 ELASTIC, 7 CUBIC, 8 CIRC, 9 BOUNCE, 10 BACK, 11 SPRING.

; ---- Shared (moved from inline numbers) ----
; Fx.flash default: fade seconds, amplitude = strength (alpha)
[sub_resource type="Resource" id="m_screen_flash"]
script = ExtResource("1_entry")
id = &"screen_flash"
duration = 0.15
delay = 0.0
ease = 1
trans = 0
amplitude = 0.45

; Fx.freeze_frames default: amplitude = frames held
[sub_resource type="Resource" id="m_hit_freeze"]
script = ExtResource("1_entry")
id = &"hit_freeze"
duration = 0.0
delay = 0.0
ease = 1
trans = 0
amplitude = 2.0

; Fx.show_saved: SAVED holds `delay`, fades over `duration`
[sub_resource type="Resource" id="m_saved_stamp"]
script = ExtResource("1_entry")
id = &"saved_stamp"
duration = 1.2
delay = 0.6
ease = 1
trans = 0
amplitude = 0.0

; Toast: on screen `delay` seconds, then fades over `duration`
[sub_resource type="Resource" id="m_toast"]
script = ExtResource("1_entry")
id = &"toast"
duration = 0.35
delay = 2.4
ease = 1
trans = 0
amplitude = 0.0

; ---- 4.1 Jack in / jack out ----
; Fx.jack_in total seconds; amplitude = CRT rect end scale (x viewport)
[sub_resource type="Resource" id="m_jack_in"]
script = ExtResource("1_entry")
id = &"jack_in"
duration = 0.7
delay = 0.0
ease = 1
trans = 0
amplitude = 1.2

