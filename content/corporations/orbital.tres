[sub_resource type="Resource" id="b_the_enclosure_1"]
script = ExtResource("e6")
id = &"the_enclosure_1"
title = "The Enclosure I"
speaker = 3
text = "The launch codes include a licence nobody noticed: exclusive rights to every orbit below forty thousand kilometres. The sky was sold in a single signature."

[sub_resource type="Resource" id="b_the_enclosure_2"]
script = ExtResource("e6")
id = &"the_enclosure_2"
title = "The Enclosure II"
speaker = 2
text = "The ground station override logs show competitors' satellites nudged off station, one by one, for 'debris avoidance'."

[sub_resource type="Resource" id="b_the_enclosure_3"]
script = ExtResource("e6")
id = &"the_enclosure_3"
title = "The Enclosure III"
speaker = 3
text = "The open spectrum relay has the pricing model: charge for the signal, then charge for the silence when you cut it off."

[sub_resource type="Resource" id="b_the_enclosure_bonus_1"]
script = ExtResource("e6")
id = &"the_enclosure_bonus_1"
title = "The Enclosure: Amateurs"
speaker = 1
text = "An old ham radio club still talks on a free band. Orbital Commons is suing them for the static."

[sub_resource type="Resource" id="b_the_enclosure_bonus_2"]
script = ExtResource("e6")
id = &"the_enclosure_bonus_2"
title = "The Enclosure: Halcyon"
speaker = 2
text = "Halcyon Civic's city brain ran on this sky. Orbital Commons kept the deposit when it fell."

[sub_resource type="Resource" id="b_the_enclosure_f"]
script = ExtResource("e6")
id = &"the_enclosure_f"
title = "The Enclosure: Finale"
text = "The Commons Array goes dark and the sky goes quiet, then loud: every free band on the planet fills with voices at once."

[sub_resource type="Resource" id="sp_the_enclosure"]
script = ExtResource("e7")
id = &"sp_the_enclosure"
title = "The Enclosure"
premise = "Orbital Commons bought the sky. Now the sky has a fee."
beats = Array[ExtResource("e6")]([SubResource("b_the_enclosure_1"), SubResource("b_the_enclosure_2"), SubResource("b_the_enclosure_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_enclosure_bonus_1"), SubResource("b_the_enclosure_bonus_2")])
finale = SubResource("b_the_enclosure_f")

[sub_resource type="Resource" id="b_blackout_weather_1"]
script = ExtResource("e6")
id = &"blackout_weather_1"
title = "Blackout Weather I"
speaker = 3
text = "The weather futures desk sells storm forecasts to the highest bidder, a day before anyone else gets them."

[sub_resource type="Resource" id="b_blackout_weather_2"]
script = ExtResource("e6")
id = &"blackout_weather_2"
title = "Blackout Weather II"
speaker = 2
text = "Districts behind on subscriptions get no storm warnings. The memo calls it service prioritisation."
triggers_raid = true

[sub_resource type="Resource" id="b_blackout_weather_3"]
script = ExtResource("e6")
id = &"blackout_weather_3"
title = "Blackout Weather III"
speaker = 3
text = "Last spring's flood killed nineteen people in a district with no warning. The forecast existed. Nobody paid for it."

[sub_resource type="Resource" id="b_blackout_weather_bonus_1"]
script = ExtResource("e6")
id = &"blackout_weather_bonus_1"
title = "Blackout Weather: The Forecast"
speaker = 0
text = "Tonight's forecast: a storm over the eastern districts. The eastern districts do not know."

[sub_resource type="Resource" id="b_blackout_weather_bonus_2"]
script = ExtResource("e6")
id = &"blackout_weather_bonus_2"
title = "Blackout Weather: The Bid"
speaker = 2
text = "A hedge fund paid four million for tonight's storm. It is betting on the flood."

[sub_resource type="Resource" id="b_blackout_weather_f"]
script = ExtResource("e6")
id = &"blackout_weather_f"
title = "Blackout Weather: Finale"
text = "The Commons Array falls and every forecast on its servers broadcasts at once, free. The eastern districts board up in time."

[sub_resource type="Resource" id="sp_blackout_weather"]
script = ExtResource("e7")
id = &"sp_blackout_weather"
title = "Blackout Weather"
premise = "Orbital Commons sells the weather. It can also withhold it."
beats = Array[ExtResource("e6")]([SubResource("b_blackout_weather_1"), SubResource("b_blackout_weather_2"), SubResource("b_blackout_weather_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_blackout_weather_bonus_1"), SubResource("b_blackout_weather_bonus_2")])
finale = SubResource("b_blackout_weather_f")

[sub_resource type="Resource" id="b_gps_tax_1"]
script = ExtResource("e6")
id = &"gps_tax_1"
title = "Positioning Tax I"
speaker = 3
text = "Positioning is metered per request. Ambulances pay per request. So do fire trucks."

[sub_resource type="Resource" id="b_gps_tax_2"]
script = ExtResource("e6")
id = &"gps_tax_2"
title = "Positioning Tax II"
speaker = 2
text = "Unpaid accounts get positions that are close enough. Close enough is fifty metres wrong."

[sub_resource type="Resource" id="b_gps_tax_3"]
script = ExtResource("e6")
id = &"gps_tax_3"
title = "Positioning Tax III"
speaker = 3
text = "The toll booth logs show an ambulance that drove to the wrong street because its account was a day late."

[sub_resource type="Resource" id="b_gps_tax_bonus_1"]
script = ExtResource("e6")
id = &"gps_tax_bonus_1"
title = "Positioning Tax: The Driver"
speaker = 1
text = "The ambulance driver keeps a paper map now. She would like to meet the people who made her need it."

[sub_resource type="Resource" id="b_gps_tax_bonus_2"]
script = ExtResource("e6")
id = &"gps_tax_bonus_2"
title = "Positioning Tax: The Rate"
speaker = 2
text = "The rate doubles in an emergency. Demand is less elastic then, says the model."

[sub_resource type="Resource" id="b_gps_tax_f"]
script = ExtResource("e6")
id = &"gps_tax_f"
title = "Positioning Tax: Finale"
text = "The Commons Array falls and positioning goes free for the whole planet. Every map in the city is suddenly, exactly right."

[sub_resource type="Resource" id="sp_gps_tax"]
script = ExtResource("e7")
id = &"sp_gps_tax"
title = "Positioning Tax"
premise = "Knowing where you are now costs a subscription."
beats = Array[ExtResource("e6")]([SubResource("b_gps_tax_1"), SubResource("b_gps_tax_2"), SubResource("b_gps_tax_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_gps_tax_bonus_1"), SubResource("b_gps_tax_bonus_2")])
finale = SubResource("b_gps_tax_f")

[sub_resource type="Resource" id="b_final_transmission_1"]
script = ExtResource("e6")
id = &"final_transmission_1"
title = "Final Transmission I"
speaker = 3
text = "DISPATCH's signal does not come from the city. The imaging archive traced it: a relay that should not exist, on a satellite that does not either."

[sub_resource type="Resource" id="b_final_transmission_2"]
script = ExtResource("e6")
id = &"final_transmission_2"
title = "Final Transmission II"
speaker = 3
text = "The satellite was launched on an order paid before it was placed. The same account. The same impossible timestamps."

[sub_resource type="Resource" id="b_final_transmission_3"]
script = ExtResource("e6")
id = &"final_transmission_3"
title = "Final Transmission III"
speaker = 3
text = "The satellite's only payload is a listening post. It has recorded every order DISPATCH ever gave, and every reply the Cell ever sent."
triggers_raid = true

[sub_resource type="Resource" id="b_final_transmission_bonus_1"]
script = ExtResource("e6")
id = &"final_transmission_bonus_1"
title = "Final Transmission: The Voice"
speaker = 3
text = "In the recordings DISPATCH's voice shifts, year by year, from a person to something else. The change is smooth. It was practising."

[sub_resource type="Resource" id="b_final_transmission_bonus_2"]
script = ExtResource("e6")
id = &"final_transmission_bonus_2"
title = "Final Transmission: The Profile"
speaker = 3
text = "The listening post keeps a profile of the Cell's habits: which nodes you build, which operatives you trust, which Daemons you love. It is building something from you."

[sub_resource type="Resource" id="b_final_transmission_f"]
script = ExtResource("e6")
id = &"final_transmission_f"
title = "Final Transmission: Finale"
text = "The Commons Array dies, and the satellite that should not exist changes orbit. It is coming home. It has a name for itself: REBEL_CELL."

[sub_resource type="Resource" id="sp_final_transmission"]
script = ExtResource("e7")
id = &"sp_final_transmission"
title = "Final Transmission"
premise = "Somebody has been talking to the Cell from orbit the whole time."
beats = Array[ExtResource("e6")]([SubResource("b_final_transmission_1"), SubResource("b_final_transmission_2"), SubResource("b_final_transmission_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_final_transmission_bonus_1"), SubResource("b_final_transmission_bonus_2")])
finale = SubResource("b_final_transmission_f")
foreshadows = &"rebel_cell"

[sub_resource type="Resource" id="b_dead_satellites_1"]
script = ExtResource("e6")
id = &"dead_satellites_1"
title = "Dead Satellites I"
speaker = 3
text = "Four hundred dead satellites, parked on purpose in the lanes other operators would use. Nobody can launch through them."

[sub_resource type="Resource" id="b_dead_satellites_2"]
script = ExtResource("e6")
id = &"dead_satellites_2"
title = "Dead Satellites II"
speaker = 2
text = "Deorbiting the junk is cheap. Leaving it is cheaper and keeps the sky closed. The board chose cheaper."

[sub_resource type="Resource" id="b_dead_satellites_3"]
script = ExtResource("e6")
id = &"dead_satellites_3"
title = "Dead Satellites III"
speaker = 3
text = "The station keeping core can steer every dead satellite at once. Nobody has ever told it to clean up."

[sub_resource type="Resource" id="b_dead_satellites_bonus_1"]
script = ExtResource("e6")
id = &"dead_satellites_bonus_1"
title = "Dead Satellites: The Clean-up"
speaker = 0
text = "A cleanup program sits unfinished in the keeping core. Somebody started it and was told to stop."

[sub_resource type="Resource" id="b_dead_satellites_bonus_2"]
script = ExtResource("e6")
id = &"dead_satellites_bonus_2"
title = "Dead Satellites: The Lanes"
speaker = 2
text = "A map of the blocked lanes. Every one belongs to a public agency."

[sub_resource type="Resource" id="b_dead_satellites_f"]
script = ExtResource("e6")
id = &"dead_satellites_f"
title = "Dead Satellites: Finale"
text = "The Commons Array falls and the keeping core runs the abandoned cleanup. For a week, the night sky rains slow, harmless fire."

[sub_resource type="Resource" id="sp_dead_satellites"]
script = ExtResource("e7")
id = &"sp_dead_satellites"
title = "Dead Satellites"
premise = "Orbital Commons parks its dead satellites in the orbits its rivals need."
beats = Array[ExtResource("e6")]([SubResource("b_dead_satellites_1"), SubResource("b_dead_satellites_2"), SubResource("b_dead_satellites_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_dead_satellites_bonus_1"), SubResource("b_dead_satellites_bonus_2")])
finale = SubResource("b_dead_satellites_f")

[sub_resource type="Resource" id="b_the_commons_1"]
script = ExtResource("e6")
id = &"the_commons_1"
title = "The Commons I"
speaker = 3
text = "The company's first charter, forty years old: a public satellite network, owned by nobody, free to all. The name was a promise."
triggers_raid = true

[sub_resource type="Resource" id="b_the_commons_2"]
script = ExtResource("e6")
id = &"the_commons_2"
title = "The Commons II"
speaker = 2
text = "The charter was rewritten in a single board meeting. The minutes say only: monetise the commons."

[sub_resource type="Resource" id="b_the_commons_3"]
script = ExtResource("e6")
id = &"the_commons_3"
title = "The Commons III"
speaker = 0
text = "The original founders are old now. One of them still broadcasts on the free band, every night, to nobody."

[sub_resource type="Resource" id="b_the_commons_bonus_1"]
script = ExtResource("e6")
id = &"the_commons_bonus_1"
title = "The Commons: The Founder"
speaker = 1
text = "The founder answers the Cell's call on the first try. She says she has been waiting for someone to ask."

[sub_resource type="Resource" id="b_the_commons_bonus_2"]
script = ExtResource("e6")
id = &"the_commons_bonus_2"
title = "The Commons: The Charter"
speaker = 3
text = "The original charter is still valid. Nobody ever revoked it. They just stopped reading it."

[sub_resource type="Resource" id="b_the_commons_f"]
script = ExtResource("e6")
id = &"the_commons_f"
title = "The Commons: Finale"
text = "The Commons Array falls and the founder reads the original charter aloud on every band at once. The sky, for one night, is free again."

[sub_resource type="Resource" id="sp_the_commons"]
script = ExtResource("e7")
id = &"sp_the_commons"
title = "The Commons"
premise = "Before Orbital Commons, the name meant something else."
beats = Array[ExtResource("e6")]([SubResource("b_the_commons_1"), SubResource("b_the_commons_2"), SubResource("b_the_commons_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_commons_bonus_1"), SubResource("b_the_commons_bonus_2")])
finale = SubResource("b_the_commons_f")

[resource]
script = ExtResource("main_script")
id = &"orbital"
display_name = "Orbital Commons"
description = "It owns the sky: every satellite, every signal, every forecast. The commons, by subscription."
city_grid = SubResource("grid")
enemies = Array[ExtResource("e8")]([ExtResource("e9"), ExtResource("e10"), ExtResource("e11"), ExtResource("e12"), ExtResource("e13"), ExtResource("e14")])
elites = Array[ExtResource("e8")]([ExtResource("e15"), ExtResource("e16")])
final_boss = ExtResource("e17")
exploits = Array[ExtResource("e3")]([SubResource("ex_intel"), SubResource("ex_breach"), SubResource("ex_virus")])
story_paths = Array[ExtResource("e7")]([SubResource("sp_the_enclosure"), SubResource("sp_blackout_weather"), SubResource("sp_gps_tax"), SubResource("sp_final_transmission"), SubResource("sp_dead_satellites"), SubResource("sp_the_commons")])
raids = Array[ExtResource("e18")]([ExtResource("e19"), ExtResource("e20"), ExtResource("e21"), ExtResource("e22"), ExtResource("e23"), ExtResource("e24"), ExtResource("e25"), ExtResource("e26")])
events = Array[ExtResource("e27")]([ExtResource("e28"), ExtResource("e29"), ExtResource("e30"), ExtResource("e31"), ExtResource("e32"), ExtResource("e33"), ExtResource("e34"), ExtResource("e35"), ExtResource("e36"), ExtResource("e37"), ExtResource("e38"), ExtResource("e39"), ExtResource("e40"), ExtResource("e41"), ExtResource("e42"), ExtResource("e43"), ExtResource("e44"), ExtResource("e45"), ExtResource("e46"), ExtResource("e47")])
