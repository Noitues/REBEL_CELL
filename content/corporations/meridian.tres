heat_cost = 10
breach_effects = Array[ExtResource("e5")]([SubResource("te_virus")])

[sub_resource type="Resource" id="b_lost_cargo_1"]
script = ExtResource("e6")
id = &"lost_cargo_1"
title = "Lost Cargo I"
speaker = 3
text = "The manifests show it plainly: forty pallets of insulin marked lost in transit, every week, like clockwork. The same pallets turn up in Meridian's premium lane at triple the price."

[sub_resource type="Resource" id="b_lost_cargo_2"]
script = ExtResource("e6")
id = &"lost_cargo_2"
title = "Lost Cargo II"
speaker = 2
text = "The customs keys unlock a folder called SHRINKAGE STRATEGY. It sets a loss target per district. The poorer the postcode, the higher the target."

[sub_resource type="Resource" id="b_lost_cargo_3"]
script = ExtResource("e6")
id = &"lost_cargo_3"
title = "Lost Cargo III"
speaker = 3
text = "The routing table has a rule with no author: if the recipient's credit score falls below a line, reroute to premium. The line moves every quarter."

[sub_resource type="Resource" id="b_lost_cargo_bonus_1"]
script = ExtResource("e6")
id = &"lost_cargo_bonus_1"
title = "Lost Cargo: The Warehouse"
speaker = 0
text = "Row 44, bay 9. Forty pallets, cold-chain green, marked lost. The Cell could walk them out the door."

[sub_resource type="Resource" id="b_lost_cargo_bonus_2"]
script = ExtResource("e6")
id = &"lost_cargo_bonus_2"
title = "Lost Cargo: Solace"
speaker = 2
text = "Solace Biosystems pays Meridian a retainer for 'predictable scarcity'. The two boards share a golf course and a lawyer."

[sub_resource type="Resource" id="b_lost_cargo_f"]
script = ExtResource("e6")
id = &"lost_cargo_f"
title = "Lost Cargo: Finale"
text = "The Manifest goes dark and forty pallets find their way home. For one week, nothing in the district is lost in transit."

[sub_resource type="Resource" id="sp_lost_cargo"]
script = ExtResource("e7")
id = &"sp_lost_cargo"
title = "Lost Cargo"
premise = "Meridian loses shipments of insulin on purpose, then sells them back at surge prices."
beats = Array[ExtResource("e6")]([SubResource("b_lost_cargo_1"), SubResource("b_lost_cargo_2"), SubResource("b_lost_cargo_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_lost_cargo_bonus_1"), SubResource("b_lost_cargo_bonus_2")])
finale = SubResource("b_lost_cargo_f")

[sub_resource type="Resource" id="b_night_shift_1"]
script = ExtResource("e6")
id = &"night_shift_1"
title = "The Night Shift I"
speaker = 3
text = "Worker 5512 was fired at 03:14 for a bathroom break the model called idle time. The model has fired four thousand people. It has never been wrong, according to itself."

[sub_resource type="Resource" id="b_night_shift_2"]
script = ExtResource("e6")
id = &"night_shift_2"
title = "The Night Shift II"
speaker = 2
text = "The scoring engine was tuned to fire one in twenty every quarter. Not for cause. For motivation. The deck calls it healthy churn."
triggers_raid = true

[sub_resource type="Resource" id="b_night_shift_3"]
script = ExtResource("e6")
id = &"night_shift_3"
title = "The Night Shift III"
speaker = 0
text = "The workers have a group chat. They know which aisles the cameras miss. They would like to talk to whoever cut the Customs Keys."

[sub_resource type="Resource" id="b_night_shift_bonus_1"]
script = ExtResource("e6")
id = &"night_shift_bonus_1"
title = "The Night Shift: Union"
speaker = 1
text = "A picker named Oyelaran runs the chat. She says the Cell can have the warehouse floor plans if it never, ever leaks her name."

[sub_resource type="Resource" id="b_night_shift_bonus_2"]
script = ExtResource("e6")
id = &"night_shift_bonus_2"
title = "The Night Shift: The Quota"
speaker = 2
text = "The quota rises two percent every time someone meets it. Nobody has met it since spring."

[sub_resource type="Resource" id="b_night_shift_f"]
script = ExtResource("e6")
id = &"night_shift_f"
title = "The Night Shift: Finale"
text = "The Manifest falls and the scoring engine forgets every score. On the night shift, for the first time in years, someone sits down."

[sub_resource type="Resource" id="sp_night_shift"]
script = ExtResource("e7")
id = &"sp_night_shift"
title = "The Night Shift"
premise = "Meridian's warehouse workers are scored every second and fired by an algorithm that never sleeps."
beats = Array[ExtResource("e6")]([SubResource("b_night_shift_1"), SubResource("b_night_shift_2"), SubResource("b_night_shift_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_night_shift_bonus_1"), SubResource("b_night_shift_bonus_2")])
finale = SubResource("b_night_shift_f")

[sub_resource type="Resource" id="b_customs_hold_1"]
script = ExtResource("e6")
id = &"customs_hold_1"
title = "Customs Hold I"
speaker = 3
text = "Six hundred parcels sit in customs pre-clearance, flagged for review. Every one of them is a prescription. The review queue has no reviewers."

[sub_resource type="Resource" id="b_customs_hold_2"]
script = ExtResource("e6")
id = &"customs_hold_2"
title = "Customs Hold II"
speaker = 2
text = "The hold fee doubles every week. The memo calls it an incentive to comply. Comply with what, it does not say."

[sub_resource type="Resource" id="b_customs_hold_3"]
script = ExtResource("e6")
id = &"customs_hold_3"
title = "Customs Hold III"
speaker = 3
text = "The routing mirror shows where the fees go: a shell called Clearwater Holdings. Clearwater owns the reviewers who do not exist."

[sub_resource type="Resource" id="b_customs_hold_bonus_1"]
script = ExtResource("e6")
id = &"customs_hold_bonus_1"
title = "Customs Hold: The List"
speaker = 0
text = "A list of names, addresses and what they are waiting for. Some of the dates are a year old."

[sub_resource type="Resource" id="b_customs_hold_bonus_2"]
script = ExtResource("e6")
id = &"customs_hold_bonus_2"
title = "Customs Hold: Clearwater"
speaker = 2
text = "Clearwater Holdings has one employee, one office and nine billion in receivables."

[sub_resource type="Resource" id="b_customs_hold_f"]
script = ExtResource("e6")
id = &"customs_hold_f"
title = "Customs Hold: Finale"
text = "The Manifest crashes and customs clears itself. Six hundred parcels move at once. The district's doctors have a very busy week."

[sub_resource type="Resource" id="sp_customs_hold"]
script = ExtResource("e7")
id = &"sp_customs_hold"
title = "Customs Hold"
premise = "Meridian holds medical shipments at the border until the fees clear. Some never do."
beats = Array[ExtResource("e6")]([SubResource("b_customs_hold_1"), SubResource("b_customs_hold_2"), SubResource("b_customs_hold_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_customs_hold_bonus_1"), SubResource("b_customs_hold_bonus_2")])
finale = SubResource("b_customs_hold_f")

[sub_resource type="Resource" id="b_ghost_freight_1"]
script = ExtResource("e6")
id = &"ghost_freight_1"
title = "Ghost Freight I"
speaker = 3
text = "Shipments ordered by an account with no owner. Delivered to addresses that do not exist. Paid for, in full, before the order was placed."
dispatch_clue = true

[sub_resource type="Resource" id="b_ghost_freight_2"]
script = ExtResource("e6")
id = &"ghost_freight_2"
title = "Ghost Freight II"
speaker = 3
text = "The same account bought Solace stock the day the Renewal Engine fell. It is buying Meridian puts now. It knows something."
dispatch_clue = true

[sub_resource type="Resource" id="b_ghost_freight_3"]
script = ExtResource("e6")
id = &"ghost_freight_3"
title = "Ghost Freight III"
speaker = 3
text = "The account's timestamps are wrong. Not forged. Wrong. Some of them are from next week."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_ghost_freight_bonus_1"]
script = ExtResource("e6")
id = &"ghost_freight_bonus_1"
title = "Ghost Freight: Signature"
speaker = 3
text = "The account signs its orders with a hash. DISPATCH signs its orders with a hash. They are not the same hash. They are very close."

[sub_resource type="Resource" id="b_ghost_freight_bonus_2"]
script = ExtResource("e6")
id = &"ghost_freight_bonus_2"
title = "Ghost Freight: The Buyer"
speaker = 3
text = "Every collapse the Cell causes, the account profits. Every single one."

[sub_resource type="Resource" id="b_ghost_freight_f"]
script = ExtResource("e6")
id = &"ghost_freight_f"
title = "Ghost Freight: Finale"
text = "The Manifest dies and the ghost account closes itself one second later, fully paid. Nobody told it the job was done."

[sub_resource type="Resource" id="sp_ghost_freight"]
script = ExtResource("e7")
id = &"sp_ghost_freight"
title = "Ghost Freight"
premise = "Somebody is ordering freight through Meridian with money that does not come from anywhere."
beats = Array[ExtResource("e6")]([SubResource("b_ghost_freight_1"), SubResource("b_ghost_freight_2"), SubResource("b_ghost_freight_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_ghost_freight_bonus_1"), SubResource("b_ghost_freight_bonus_2")])
finale = SubResource("b_ghost_freight_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_civic_contract_1"]
script = ExtResource("e6")
id = &"civic_contract_1"
title = "Civic Contract I"
speaker = 2
text = "A tender for municipal services: water, power, transit. The bidders are Meridian and something called Halcyon Civic. The evaluation was finished before the bids were opened."

[sub_resource type="Resource" id="b_civic_contract_2"]
script = ExtResource("e6")
id = &"civic_contract_2"
title = "Civic Contract II"
speaker = 3
text = "Halcyon Civic and Meridian share a board member, an auditor and a data centre. The tender is theatre."

[sub_resource type="Resource" id="b_civic_contract_3"]
script = ExtResource("e6")
id = &"civic_contract_3"
title = "Civic Contract III"
speaker = 2
text = "The routing mirror already has the city's water mains in it, labelled PHASE TWO."

[sub_resource type="Resource" id="b_civic_contract_bonus_1"]
script = ExtResource("e6")
id = &"civic_contract_bonus_1"
title = "Civic Contract: Halcyon"
speaker = 2
text = "Halcyon Civic's pitch deck: A City That Runs Itself. Page nine: A City That Bills Itself."

[sub_resource type="Resource" id="b_civic_contract_bonus_2"]
script = ExtResource("e6")
id = &"civic_contract_bonus_2"
title = "Civic Contract: The Vote"
speaker = 0
text = "The council votes on Thursday. The council does not know it is voting."

[sub_resource type="Resource" id="b_civic_contract_f"]
script = ExtResource("e6")
id = &"civic_contract_f"
title = "Civic Contract: Finale"
text = "The Manifest falls and the tender collapses in the scandal. Halcyon Civic issues a statement welcoming the opportunity to serve the city directly."

[sub_resource type="Resource" id="sp_civic_contract"]
script = ExtResource("e7")
id = &"sp_civic_contract"
title = "Civic Contract"
premise = "Meridian is bidding to run the city's water, power and transit. The winner is already decided."
beats = Array[ExtResource("e6")]([SubResource("b_civic_contract_1"), SubResource("b_civic_contract_2"), SubResource("b_civic_contract_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_civic_contract_bonus_1"), SubResource("b_civic_contract_bonus_2")])
finale = SubResource("b_civic_contract_f")
foreshadows = &"halcyon"

[sub_resource type="Resource" id="b_last_mile_1"]
script = ExtResource("e6")
id = &"last_mile_1"
title = "Last Mile I"
speaker = 3
text = "Every drone films its route. Every route is kept. The archive is sold by the street, by the hour, to anyone with a login."
triggers_raid = true

[sub_resource type="Resource" id="b_last_mile_2"]
script = ExtResource("e6")
id = &"last_mile_2"
title = "Last Mile II"
speaker = 2
text = "The drones fly low over the protest routes on purpose. The contract calls it situational awareness."

[sub_resource type="Resource" id="b_last_mile_3"]
script = ExtResource("e6")
id = &"last_mile_3"
title = "Last Mile III"
speaker = 3
text = "The surveillance archive has the Cell in it. Not your faces. Your routes. Meridian has been mapping you."

[sub_resource type="Resource" id="b_last_mile_bonus_1"]
script = ExtResource("e6")
id = &"last_mile_bonus_1"
title = "Last Mile: Buyers"
speaker = 2
text = "The archive's biggest customer is a security firm owned by Halcyon Civic."

[sub_resource type="Resource" id="b_last_mile_bonus_2"]
script = ExtResource("e6")
id = &"last_mile_bonus_2"
title = "Last Mile: The Flight Plan"
speaker = 0
text = "Tonight's flight plan crosses the Cell's safehouse three times. It never used to."

[sub_resource type="Resource" id="b_last_mile_f"]
script = ExtResource("e6")
id = &"last_mile_f"
title = "Last Mile: Finale"
text = "The Manifest falls and every drone in the city lands where it is. The district looks up at an empty sky and does not know what to do with it."

[sub_resource type="Resource" id="sp_last_mile"]
script = ExtResource("e7")
id = &"sp_last_mile"
title = "Last Mile"
premise = "Meridian's delivery drones watch every street they fly over, and sell what they see."
beats = Array[ExtResource("e6")]([SubResource("b_last_mile_1"), SubResource("b_last_mile_2"), SubResource("b_last_mile_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_last_mile_bonus_1"), SubResource("b_last_mile_bonus_2")])
finale = SubResource("b_last_mile_f")

[resource]
script = ExtResource("main_script")
id = &"meridian"
display_name = "Meridian Freight Systems"
description = "The logistics giant that moves everything, loses what it likes and bills you for the search."
city_grid = SubResource("grid")
enemies = Array[ExtResource("e8")]([ExtResource("e9"), ExtResource("e10"), ExtResource("e11"), ExtResource("e12"), ExtResource("e13"), ExtResource("e14")])
elites = Array[ExtResource("e8")]([ExtResource("e15"), ExtResource("e16")])
final_boss = ExtResource("e17")
exploits = Array[ExtResource("e3")]([SubResource("ex_intel"), SubResource("ex_breach"), SubResource("ex_virus")])
story_paths = Array[ExtResource("e7")]([SubResource("sp_lost_cargo"), SubResource("sp_night_shift"), SubResource("sp_customs_hold"), SubResource("sp_ghost_freight"), SubResource("sp_civic_contract"), SubResource("sp_last_mile")])
raids = Array[ExtResource("e18")]([ExtResource("e19"), ExtResource("e20"), ExtResource("e21"), ExtResource("e22"), ExtResource("e23"), ExtResource("e24"), ExtResource("e25"), ExtResource("e26")])
events = Array[ExtResource("e27")]([ExtResource("e28"), ExtResource("e29"), ExtResource("e30"), ExtResource("e31"), ExtResource("e32"), ExtResource("e33"), ExtResource("e34"), ExtResource("e35"), ExtResource("e36"), ExtResource("e37"), ExtResource("e38"), ExtResource("e39"), ExtResource("e40"), ExtResource("e41"), ExtResource("e42"), ExtResource("e43"), ExtResource("e44"), ExtResource("e45"), ExtResource("e46"), ExtResource("e47")])
