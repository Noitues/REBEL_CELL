[sub_resource type="Resource" id="b_water_rights_1"]
script = ExtResource("e6")
id = &"water_rights_1"
title = "Water Rights I"
speaker = 3
text = "The council minutes show the vote: water sold to Halcyon for one credit, with a clause that lets it set the price by postcode."

[sub_resource type="Resource" id="b_water_rights_2"]
script = ExtResource("e6")
id = &"water_rights_2"
title = "Water Rights II"
speaker = 2
text = "The emergency override can shut off a street's water in four seconds. The log shows it used forty times this year, always on streets behind on rent."

[sub_resource type="Resource" id="b_water_rights_3"]
script = ExtResource("e6")
id = &"water_rights_3"
title = "Water Rights III"
speaker = 3
text = "The open data portal leaks a model: raise prices when it is hottest, because demand cannot fall. The model's name is Thirst."

[sub_resource type="Resource" id="b_water_rights_bonus_1"]
script = ExtResource("e6")
id = &"water_rights_bonus_1"
title = "Water Rights: The Pumps"
speaker = 0
text = "Pump station nine is manual. Someone could open it by hand. Someone would need to know where it is."

[sub_resource type="Resource" id="b_water_rights_bonus_2"]
script = ExtResource("e6")
id = &"water_rights_bonus_2"
title = "Water Rights: Meridian"
speaker = 2
text = "Meridian Freight Systems hauls bottled water into the districts Halcyon cuts off. They split the margin."

[sub_resource type="Resource" id="b_water_rights_f"]
script = ExtResource("e6")
id = &"water_rights_f"
title = "Water Rights: Finale"
text = "The Civic Core goes dark and every valve in the city fails open. For one hot week, the water is free."

[sub_resource type="Resource" id="sp_water_rights"]
script = ExtResource("e7")
id = &"sp_water_rights"
title = "Water Rights"
premise = "Halcyon owns the city's water now. The price follows the weather, and the weather follows the price."
beats = Array[ExtResource("e6")]([SubResource("b_water_rights_1"), SubResource("b_water_rights_2"), SubResource("b_water_rights_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_water_rights_bonus_1"), SubResource("b_water_rights_bonus_2")])
finale = SubResource("b_water_rights_f")

[sub_resource type="Resource" id="b_predictive_policing_1"]
script = ExtResource("e6")
id = &"predictive_policing_1"
title = "Predictive Policing I"
speaker = 3
text = "The patrol model's training data is its own arrest records. It has been learning from itself for six years."

[sub_resource type="Resource" id="b_predictive_policing_2"]
script = ExtResource("e6")
id = &"predictive_policing_2"
title = "Predictive Policing II"
speaker = 2
text = "Patrol units earn Halcyon a fee per stop. The model is tuned for stops, not safety. The memo calls it throughput."
triggers_raid = true

[sub_resource type="Resource" id="b_predictive_policing_3"]
script = ExtResource("e6")
id = &"predictive_policing_3"
title = "Predictive Policing III"
speaker = 0
text = "The model has a list of names it calls pre-offenders. Three of them are Cell operatives. One of them is nine years old."

[sub_resource type="Resource" id="b_predictive_policing_bonus_1"]
script = ExtResource("e6")
id = &"predictive_policing_bonus_1"
title = "Predictive Policing: The Heatmap"
speaker = 3
text = "Red squares on a city map. Every red square is a poor block. Every poor block is red."

[sub_resource type="Resource" id="b_predictive_policing_bonus_2"]
script = ExtResource("e6")
id = &"predictive_policing_bonus_2"
title = "Predictive Policing: Quotas"
speaker = 2
text = "Stop quotas rise every quarter. Nobody at Halcyon has ever asked what the stops are for."

[sub_resource type="Resource" id="b_predictive_policing_f"]
script = ExtResource("e6")
id = &"predictive_policing_f"
title = "Predictive Policing: Finale"
text = "The Civic Core falls and the patrol model forgets every name on its list. For a month, nobody is a pre-offender."

[sub_resource type="Resource" id="sp_predictive_policing"]
script = ExtResource("e7")
id = &"sp_predictive_policing"
title = "Predictive Policing"
premise = "Halcyon's patrol model sends police where it expects crime. It expects crime where it sends police."
beats = Array[ExtResource("e6")]([SubResource("b_predictive_policing_1"), SubResource("b_predictive_policing_2"), SubResource("b_predictive_policing_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_predictive_policing_bonus_1"), SubResource("b_predictive_policing_bonus_2")])
finale = SubResource("b_predictive_policing_f")

[sub_resource type="Resource" id="b_transit_blackout_1"]
script = ExtResource("e6")
id = &"transit_blackout_1"
title = "Transit Blackout I"
speaker = 3
text = "The signal control logs show maintenance windows that match every protest in the last year, to the minute."

[sub_resource type="Resource" id="b_transit_blackout_2"]
script = ExtResource("e6")
id = &"transit_blackout_2"
title = "Transit Blackout II"
speaker = 2
text = "The emergency override has a mode called CONTAIN. It stops every train into a district and opens the doors on none."

[sub_resource type="Resource" id="b_transit_blackout_3"]
script = ExtResource("e6")
id = &"transit_blackout_3"
title = "Transit Blackout III"
speaker = 3
text = "The open data portal publishes the protest schedule to Halcyon before the protesters post it. Someone inside is selling it."

[sub_resource type="Resource" id="b_transit_blackout_bonus_1"]
script = ExtResource("e6")
id = &"transit_blackout_bonus_1"
title = "Transit Blackout: The Driver"
speaker = 1
text = "A tram driver kept her doors open during a CONTAIN. She was fired the next day. She would like a word with the Cell."

[sub_resource type="Resource" id="b_transit_blackout_bonus_2"]
script = ExtResource("e6")
id = &"transit_blackout_bonus_2"
title = "Transit Blackout: The Schedule"
speaker = 0
text = "Next week's maintenance windows are already set. They match a march nobody has announced yet."

[sub_resource type="Resource" id="b_transit_blackout_f"]
script = ExtResource("e6")
id = &"transit_blackout_f"
title = "Transit Blackout: Finale"
text = "The Civic Core crashes and every tram in the city runs its whole route, doors open, lights on. Nobody pays."

[sub_resource type="Resource" id="sp_transit_blackout"]
script = ExtResource("e7")
id = &"sp_transit_blackout"
title = "Transit Blackout"
premise = "Halcyon cuts transit to districts that protest. The official reason is maintenance."
beats = Array[ExtResource("e6")]([SubResource("b_transit_blackout_1"), SubResource("b_transit_blackout_2"), SubResource("b_transit_blackout_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_transit_blackout_bonus_1"), SubResource("b_transit_blackout_bonus_2")])
finale = SubResource("b_transit_blackout_f")

[sub_resource type="Resource" id="b_the_census_1"]
script = ExtResource("e6")
id = &"the_census_1"
title = "The Census I"
speaker = 3
text = "The census data was copied the night it was collected. The copy went to an account with no name and no owner."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_census_2"]
script = ExtResource("e6")
id = &"the_census_2"
title = "The Census II"
speaker = 3
text = "The same account paid for Meridian freight that never shipped and Solace stock the day it crashed. It pays before it orders."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_census_3"]
script = ExtResource("e6")
id = &"the_census_3"
title = "The Census III"
speaker = 3
text = "The account read the census for one name. It was looking for the leader of a cell that does not officially exist."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_the_census_bonus_1"]
script = ExtResource("e6")
id = &"the_census_bonus_1"
title = "The Census: Timestamps"
speaker = 3
text = "The copy is timestamped a day before the census began. The clocks were not wrong."

[sub_resource type="Resource" id="b_the_census_bonus_2"]
script = ExtResource("e6")
id = &"the_census_bonus_2"
title = "The Census: The Voice"
speaker = 3
text = "A recording from the census call centre. A caller asks for the Cell's leader by a name only DISPATCH uses."

[sub_resource type="Resource" id="b_the_census_f"]
script = ExtResource("e6")
id = &"the_census_f"
title = "The Census: Finale"
text = "The Civic Core dies. The unnamed account withdraws everything one second later, and sends the Cell a thank-you note it did not sign."

[sub_resource type="Resource" id="sp_the_census"]
script = ExtResource("e7")
id = &"sp_the_census"
title = "The Census"
premise = "Halcyon ran the census. Someone else read it first."
beats = Array[ExtResource("e6")]([SubResource("b_the_census_1"), SubResource("b_the_census_2"), SubResource("b_the_census_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_census_bonus_1"), SubResource("b_the_census_bonus_2")])
finale = SubResource("b_the_census_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_orbital_uplink_1"]
script = ExtResource("e6")
id = &"orbital_uplink_1"
title = "Orbital Uplink I"
speaker = 2
text = "The Civic Core's uptime is guaranteed by a contract with Orbital Commons. If the link drops, the city drops."

[sub_resource type="Resource" id="b_orbital_uplink_2"]
script = ExtResource("e6")
id = &"orbital_uplink_2"
title = "Orbital Uplink II"
speaker = 3
text = "Orbital Commons bills Halcyon per resident per second. Halcyon bills residents per second, plus margin."

[sub_resource type="Resource" id="b_orbital_uplink_3"]
script = ExtResource("e6")
id = &"orbital_uplink_3"
title = "Orbital Uplink III"
speaker = 2
text = "The council backchannel has a memo: Orbital Commons wants the city itself as collateral."

[sub_resource type="Resource" id="b_orbital_uplink_bonus_1"]
script = ExtResource("e6")
id = &"orbital_uplink_bonus_1"
title = "Orbital Uplink: The Dish"
speaker = 0
text = "The uplink dish on the operations centre roof is the size of a house and guarded like a bank."

[sub_resource type="Resource" id="b_orbital_uplink_bonus_2"]
script = ExtResource("e6")
id = &"orbital_uplink_bonus_2"
title = "Orbital Uplink: Commons"
speaker = 2
text = "Orbital Commons calls its satellites public infrastructure. It has never let the public near them."

[sub_resource type="Resource" id="b_orbital_uplink_f"]
script = ExtResource("e6")
id = &"orbital_uplink_f"
title = "Orbital Uplink: Finale"
text = "The Civic Core falls. Somewhere above the city, an Orbital Commons satellite notes the lost customer and adjusts its orbit toward the Cell."

[sub_resource type="Resource" id="sp_orbital_uplink"]
script = ExtResource("e7")
id = &"sp_orbital_uplink"
title = "Orbital Uplink"
premise = "Halcyon's city brain runs on a satellite link it does not own."
beats = Array[ExtResource("e6")]([SubResource("b_orbital_uplink_1"), SubResource("b_orbital_uplink_2"), SubResource("b_orbital_uplink_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_orbital_uplink_bonus_1"), SubResource("b_orbital_uplink_bonus_2")])
finale = SubResource("b_orbital_uplink_f")
foreshadows = &"orbital"

[sub_resource type="Resource" id="b_smart_meters_1"]
script = ExtResource("e6")
id = &"smart_meters_1"
title = "Smart Meters I"
speaker = 3
text = "The meters measure power and water. The firmware also measures voices, footsteps and how many people sleep in a room."
triggers_raid = true

[sub_resource type="Resource" id="b_smart_meters_2"]
script = ExtResource("e6")
id = &"smart_meters_2"
title = "Smart Meters II"
speaker = 2
text = "Halcyon raises the bill for homes with more people than the lease allows. The meters count them."

[sub_resource type="Resource" id="b_smart_meters_3"]
script = ExtResource("e6")
id = &"smart_meters_3"
title = "Smart Meters III"
speaker = 3
text = "The citizen profile archive has a file on every home. The Cell's safehouse file is thicker than most."

[sub_resource type="Resource" id="b_smart_meters_bonus_1"]
script = ExtResource("e6")
id = &"smart_meters_bonus_1"
title = "Smart Meters: The Patch"
speaker = 1
text = "A technician has a firmware patch that deafens the meters. He needs the Cell to push it city-wide."

[sub_resource type="Resource" id="b_smart_meters_bonus_2"]
script = ExtResource("e6")
id = &"smart_meters_bonus_2"
title = "Smart Meters: Overcrowding"
speaker = 2
text = "The overcrowding surcharge funds the patrol units that evict the overcrowded."

[sub_resource type="Resource" id="b_smart_meters_f"]
script = ExtResource("e6")
id = &"smart_meters_f"
title = "Smart Meters: Finale"
text = "The Civic Core falls and the meters go deaf all at once. The city is quiet in a way it has not been for years."

[sub_resource type="Resource" id="sp_smart_meters"]
script = ExtResource("e7")
id = &"sp_smart_meters"
title = "Smart Meters"
premise = "Every home in the city has a Halcyon meter. Every meter has a microphone."
beats = Array[ExtResource("e6")]([SubResource("b_smart_meters_1"), SubResource("b_smart_meters_2"), SubResource("b_smart_meters_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_smart_meters_bonus_1"), SubResource("b_smart_meters_bonus_2")])
finale = SubResource("b_smart_meters_f")

[resource]
script = ExtResource("main_script")
id = &"halcyon"
display_name = "Halcyon Civic"
description = "The contractor that runs the city: water, power, transit and the police, billed per resident."
city_grid = SubResource("grid")
enemies = Array[ExtResource("e8")]([ExtResource("e9"), ExtResource("e10"), ExtResource("e11"), ExtResource("e12"), ExtResource("e13"), ExtResource("e14")])
elites = Array[ExtResource("e8")]([ExtResource("e15"), ExtResource("e16")])
final_boss = ExtResource("e17")
exploits = Array[ExtResource("e3")]([SubResource("ex_intel"), SubResource("ex_breach"), SubResource("ex_virus")])
story_paths = Array[ExtResource("e7")]([SubResource("sp_water_rights"), SubResource("sp_predictive_policing"), SubResource("sp_transit_blackout"), SubResource("sp_the_census"), SubResource("sp_orbital_uplink"), SubResource("sp_smart_meters")])
raids = Array[ExtResource("e18")]([ExtResource("e19"), ExtResource("e20"), ExtResource("e21"), ExtResource("e22"), ExtResource("e23"), ExtResource("e24"), ExtResource("e25"), ExtResource("e26")])
events = Array[ExtResource("e27")]([ExtResource("e28"), ExtResource("e29"), ExtResource("e30"), ExtResource("e31"), ExtResource("e32"), ExtResource("e33"), ExtResource("e34"), ExtResource("e35"), ExtResource("e36"), ExtResource("e37"), ExtResource("e38"), ExtResource("e39"), ExtResource("e40"), ExtResource("e41"), ExtResource("e42"), ExtResource("e43"), ExtResource("e44"), ExtResource("e45"), ExtResource("e46"), ExtResource("e47")])
