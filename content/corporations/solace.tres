; ---- Exploits (GDD 11.7) ----

[sub_resource type="Resource" id="ex_intel"]
script = ExtResource("4")
exploit_type = 1
display_name = "Intel: Pricing Memos"
description = "Reveals the boss phases and pointer moves; opens locked Grid links."
heat_cost = 10
reveals_boss_phases = true
opens_locked_links = true

[sub_resource type="Resource" id="ex_breach"]
script = ExtResource("4")
exploit_type = 2
display_name = "Breach: Kill-Switch"
description = "The boss starts with one fewer pointer."
heat_cost = 10
removes_boss_pointers = 1

[sub_resource type="Resource" id="fx_virus"]
script = ExtResource("8")
type = 4
target = 2
status = 1
slice_pick = 1
amount = 2

[sub_resource type="Resource" id="te_virus"]
script = ExtResource("7")
trigger = 1
effects = Array[ExtResource("8")]([SubResource("fx_virus")])

[sub_resource type="Resource" id="ex_virus"]
script = ExtResource("4")
exploit_type = 3
display_name = "Virus: Open-Source Patch"
description = "The boss starts with CORRUPTED slices."
heat_cost = 10
breach_effects = Array[ExtResource("7")]([SubResource("te_virus")])

; ---- Story paths (GDD 8.4), placeholder beats ----

[sub_resource type="Resource" id="b_rn_1"]
script = ExtResource("6")
id = &"rn_1"
title = "Recall Notice I"
text = "Placeholder: the pricing memos mention a silent recall. Implants failing quietly."

[sub_resource type="Resource" id="b_rn_2"]
script = ExtResource("6")
id = &"rn_2"
title = "Recall Notice II"
text = "Placeholder: the kill-switch was never meant to be used. It was used."

[sub_resource type="Resource" id="b_rn_3"]
script = ExtResource("6")
id = &"rn_3"
title = "Recall Notice III"
text = "Placeholder: the patch works. Solace buried it to protect renewals."

[sub_resource type="Resource" id="b_rn_f"]
script = ExtResource("6")
id = &"rn_f"
title = "Recall Notice: Finale"
text = "Placeholder finale: the Renewal Engine goes dark and the recall notice goes public."

[sub_resource type="Resource" id="sp_recall"]
script = ExtResource("5")
id = &"sp_recall_notice"
title = "Recall Notice"
premise = "Placeholder: a hardware recall Solace never announced."
beats = Array[ExtResource("6")]([SubResource("b_rn_1"), SubResource("b_rn_2"), SubResource("b_rn_3")])
finale = SubResource("b_rn_f")

[sub_resource type="Resource" id="b_ct_1"]
script = ExtResource("6")
id = &"ct_1"
title = "Clinical Trial I"
text = "Placeholder: the trial cohort never consented to the subscription clause."

[sub_resource type="Resource" id="b_ct_2"]
script = ExtResource("6")
id = &"ct_2"
title = "Clinical Trial II"
text = "Placeholder: the control group had their implants bricked first."

[sub_resource type="Resource" id="b_ct_3"]
script = ExtResource("6")
id = &"ct_3"
title = "Clinical Trial III"
text = "Placeholder: the patch was the trial result they hid."

[sub_resource type="Resource" id="b_ct_f"]
script = ExtResource("6")
id = &"ct_f"
title = "Clinical Trial: Finale"
text = "Placeholder finale: the cohort data leaks with the Renewal Engine."

[sub_resource type="Resource" id="sp_trial"]
script = ExtResource("5")
id = &"sp_clinical_trial"
title = "Clinical Trial"
premise = "Placeholder: the Continuum was tested on people who could not say no."
beats = Array[ExtResource("6")]([SubResource("b_ct_1"), SubResource("b_ct_2"), SubResource("b_ct_3")])
finale = SubResource("b_ct_f")

[sub_resource type="Resource" id="b_tos_1"]
