finale = SubResource("b_gp_f")
foreshadows = &"dispatch"

[resource]
script = ExtResource("1")
id = &"solace"
display_name = "Solace Biosystems"
description = "Life-critical implants sold as the Continuum subscription. Miss a payment and the implant bricks."
city_grid = SubResource("grid")
enemies = Array[ExtResource("9")]([ExtResource("e_collections"), ExtResource("e_triage"), ExtResource("e_compliance"), ExtResource("e_dosage"), ExtResource("e_billing"), ExtResource("e_swarm")])
elites = Array[ExtResource("9")]([ExtResource("e_adjuster"), ExtResource("e_recall")])
final_boss = ExtResource("e_boss")
exploits = Array[ExtResource("4")]([SubResource("ex_intel"), SubResource("ex_breach"), SubResource("ex_virus")])
