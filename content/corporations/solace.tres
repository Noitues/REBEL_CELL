; Solace Biosystems (GDD 8.3, A.6). City Grid: home -> three T1 -> their T2 Exploit
; Sites (Intel, Breach, Virus) -> one T3 -> the Renewal Engine (T4 boss), plus the
; Scrub Records Heat objective off t1_a. Locked cross-links between the T1 Sites open
; with the Intel Exploit. SiteObjective: 0 NONE, 1 EXPLOIT, 2 HEAT_REDUCTION, 4 BOSS.
; ExploitType: 1 INTEL, 2 BREACH, 3 VIRUS.

[sub_resource type="Resource" id="site_home"]
script = ExtResource("3")
id = &"home"
display_name = "Home Server"
tier = 1
links = Array[StringName]([&"t1_a", &"t1_b", &"t1_c"])
claimable = false
map_position = Vector2(0, 200)

[sub_resource type="Resource" id="site_t1_a"]
script = ExtResource("3")
id = &"t1_a"
display_name = "Continuum Billing Farm"
tier = 1
links = Array[StringName]([&"t2_intel", &"scrub_records"])
locked_links = Array[StringName]([&"t1_b"])
map_position = Vector2(200, 80)

[sub_resource type="Resource" id="site_t1_b"]
script = ExtResource("3")
id = &"t1_b"
display_name = "Implant Provisioning Hub"
tier = 1
links = Array[StringName]([&"t2_breach"])
locked_links = Array[StringName]([&"t1_c"])
map_position = Vector2(200, 200)

[sub_resource type="Resource" id="site_t1_c"]
script = ExtResource("3")
id = &"t1_c"
display_name = "Patient Records Vault"
tier = 1
links = Array[StringName]([&"t2_virus"])
map_position = Vector2(200, 320)

[sub_resource type="Resource" id="site_scrub"]
script = ExtResource("3")
id = &"scrub_records"
display_name = "Scrub Records"
tier = 1
objective = 2
heat_change = -5
map_position = Vector2(320, 0)

[sub_resource type="Resource" id="site_t2_intel"]
script = ExtResource("3")
id = &"t2_intel"
display_name = "Pricing Memo Archive"
tier = 2
links = Array[StringName]([&"t3_core"])
objective = 1
exploit_type = 1
map_position = Vector2(420, 80)

[sub_resource type="Resource" id="site_t2_breach"]
script = ExtResource("3")
id = &"t2_breach"
display_name = "Kill-Switch Authority"
tier = 2
links = Array[StringName]([&"t3_core"])
objective = 1
exploit_type = 2
map_position = Vector2(420, 200)

[sub_resource type="Resource" id="site_t2_virus"]
script = ExtResource("3")
id = &"t2_virus"
display_name = "Patch Distribution Node"
tier = 2
links = Array[StringName]([&"t3_core"])
objective = 1
exploit_type = 3
map_position = Vector2(420, 320)

[sub_resource type="Resource" id="site_t3"]
script = ExtResource("3")
id = &"t3_core"
display_name = "Continuum Core Cluster"
tier = 3
links = Array[StringName]([&"renewal_engine_site"])
map_position = Vector2(640, 200)

[sub_resource type="Resource" id="site_boss"]
script = ExtResource("3")
id = &"renewal_engine_site"
display_name = "Renewal Engine"
tier = 4
objective = 4
claimable = false
map_position = Vector2(860, 200)

[sub_resource type="Resource" id="grid"]
script = ExtResource("2")
sites = Array[ExtResource("3")]([SubResource("site_home"), SubResource("site_t1_a"), SubResource("site_t1_b"), SubResource("site_t1_c"), SubResource("site_scrub"), SubResource("site_t2_intel"), SubResource("site_t2_breach"), SubResource("site_t2_virus"), SubResource("site_t3"), SubResource("site_boss")])
home_site_id = &"home"
boss_site_id = &"renewal_engine_site"

; ---- Exploits (GDD 11.7) ----

[sub_resource type="Resource" id="ex_intel"]
script = ExtResource("4")
exploit_type = 1
display_name = "Intel: Pricing Memos"
description = "Reveals the boss phases and pointer moves; opens locked Grid links."
heat_cost = 10
reveals_boss_phases = true
opens_locked_links = true

[sub_resource type="Resource" id="ex_breach"]
script = ExtResource("4")
exploit_type = 2
display_name = "Breach: Kill-Switch"
description = "The boss starts with one fewer pointer."
heat_cost = 10
removes_boss_pointers = 1

[sub_resource type="Resource" id="fx_virus"]
script = ExtResource("8")
type = 4
target = 2
status = 1
slice_pick = 1
amount = 2

[sub_resource type="Resource" id="te_virus"]
script = ExtResource("7")
trigger = 1
effects = Array[ExtResource("8")]([SubResource("fx_virus")])

[sub_resource type="Resource" id="ex_virus"]
script = ExtResource("4")
exploit_type = 3
display_name = "Virus: Open-Source Patch"
description = "The boss starts with CORRUPTED slices."
heat_cost = 10
breach_effects = Array[ExtResource("7")]([SubResource("te_virus")])

; ---- Story paths (GDD 8.4), placeholder beats ----

[sub_resource type="Resource" id="b_rn_1"]
script = ExtResource("6")
id = &"rn_1"
title = "Recall Notice I"
text = "Placeholder: the pricing memos mention a silent recall. Implants failing quietly."

[sub_resource type="Resource" id="b_rn_2"]
script = ExtResource("6")
id = &"rn_2"
title = "Recall Notice II"
text = "Placeholder: the kill-switch was never meant to be used. It was used."

[sub_resource type="Resource" id="b_rn_3"]
script = ExtResource("6")
id = &"rn_3"
title = "Recall Notice III"
text = "Placeholder: the patch works. Solace buried it to protect renewals."

[sub_resource type="Resource" id="b_rn_f"]
script = ExtResource("6")
id = &"rn_f"
title = "Recall Notice: Finale"
text = "Placeholder finale: the Renewal Engine goes dark and the recall notice goes public."

[sub_resource type="Resource" id="sp_recall"]
script = ExtResource("5")
id = &"sp_recall_notice"
title = "Recall Notice"
premise = "Placeholder: a hardware recall Solace never announced."
beats = Array[ExtResource("6")]([SubResource("b_rn_1"), SubResource("b_rn_2"), SubResource("b_rn_3")])
finale = SubResource("b_rn_f")

[sub_resource type="Resource" id="b_ct_1"]
