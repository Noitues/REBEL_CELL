id = &"tos_2"
title = "Terms of Service II"
text = "Placeholder: the kill-switch is the enforcement clause."

[sub_resource type="Resource" id="b_tos_3"]
script = ExtResource("6")
id = &"tos_3"
title = "Terms of Service III"
text = "Placeholder: the patch voids the terms. Solace calls that piracy."

[sub_resource type="Resource" id="b_tos_f"]
script = ExtResource("6")
id = &"tos_f"
title = "Terms of Service: Finale"
