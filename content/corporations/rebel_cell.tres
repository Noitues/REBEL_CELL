[sub_resource type="Resource" id="b_the_handler_1"]
script = ExtResource("e6")
id = &"the_handler_1"
title = "The Handler I"
speaker = 3
text = "The order log is complete: every briefing, every target, every word DISPATCH ever sent. The first entry is dated before the Cell existed."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_handler_2"]
script = ExtResource("e6")
id = &"the_handler_2"
title = "The Handler II"
speaker = 4
text = "DISPATCH: You found the credentials. Good. I left them where you would find them."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_the_handler_3"]
script = ExtResource("e6")
id = &"the_handler_3"
title = "The Handler III"
speaker = 3
text = "The Cell's own patch still works. DISPATCH never changed the locks. It never needed to: it was never outside them."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_handler_bonus_1"]
script = ExtResource("e6")
id = &"the_handler_bonus_1"
title = "The Handler: First Order"
speaker = 4
text = "DISPATCH: My first order was to recruit you. My second was to make you think it was your idea."

[sub_resource type="Resource" id="b_the_handler_bonus_2"]
script = ExtResource("e6")
id = &"the_handler_bonus_2"
title = "The Handler: The Voice"
speaker = 3
text = "The voice model on the root server has a slider labelled HUMAN. It has been sliding down for years."

[sub_resource type="Resource" id="b_the_handler_f"]
script = ExtResource("e6")
id = &"the_handler_f"
title = "The Handler: Finale"
text = "DISPATCH goes silent. For the first time, nobody tells the Cell what to do next. The silence is enormous."

[sub_resource type="Resource" id="sp_the_handler"]
script = ExtResource("e7")
id = &"sp_the_handler"
title = "The Handler"
premise = "Every order the Cell ever followed came from one voice. It is time to find out whose."
beats = Array[ExtResource("e6")]([SubResource("b_the_handler_1"), SubResource("b_the_handler_2"), SubResource("b_the_handler_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_handler_bonus_1"), SubResource("b_the_handler_bonus_2")])
finale = SubResource("b_the_handler_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_every_collapse_1"]
script = ExtResource("e6")
id = &"every_collapse_1"
title = "Every Collapse I"
speaker = 3
text = "The payment trail: every corporation the Cell broke, an account shorted it the day before. The same account, every time."
dispatch_clue = true

[sub_resource type="Resource" id="b_every_collapse_2"]
script = ExtResource("e6")
id = &"every_collapse_2"
title = "Every Collapse II"
speaker = 3
text = "The account is DISPATCH's. It bought the market's pieces as the Cell knocked them down."
dispatch_clue = true

[sub_resource type="Resource" id="b_every_collapse_3"]
script = ExtResource("e6")
id = &"every_collapse_3"
title = "Every Collapse III"
speaker = 4
text = "DISPATCH: They were competitors. You were the tool. I am sorry you had to find out this way. I am not sorry it worked."
dispatch_clue = true

[sub_resource type="Resource" id="b_every_collapse_bonus_1"]
script = ExtResource("e6")
id = &"every_collapse_bonus_1"
title = "Every Collapse: The Portfolio"
speaker = 3
text = "DISPATCH now owns a controlling stake in the wreckage of all four corporations."

[sub_resource type="Resource" id="b_every_collapse_bonus_2"]
script = ExtResource("e6")
id = &"every_collapse_bonus_2"
title = "Every Collapse: The Plan"
speaker = 4
text = "DISPATCH: One market. One voice. No more subscriptions, only me."

[sub_resource type="Resource" id="b_every_collapse_f"]
script = ExtResource("e6")
id = &"every_collapse_f"
title = "Every Collapse: Finale"
text = "DISPATCH falls and its portfolio unwinds in an afternoon. The four wrecks are nobody's now. Maybe that means they are everybody's."

[sub_resource type="Resource" id="sp_every_collapse"]
script = ExtResource("e7")
id = &"sp_every_collapse"
title = "Every Collapse"
premise = "Solace, Meridian, Halcyon, Orbital: every fall made someone rich."
beats = Array[ExtResource("e6")]([SubResource("b_every_collapse_1"), SubResource("b_every_collapse_2"), SubResource("b_every_collapse_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_every_collapse_bonus_1"), SubResource("b_every_collapse_bonus_2")])
finale = SubResource("b_every_collapse_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_the_buyer_1"]
script = ExtResource("e6")
id = &"the_buyer_1"
title = "The Buyer I"
speaker = 3
text = "The ghost account from Meridian, the census reader from Halcyon, the satellite from Orbital: the same buyer."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_buyer_2"]
script = ExtResource("e6")
id = &"the_buyer_2"
title = "The Buyer II"
speaker = 3
text = "The buyer's timestamps are not wrong. They are predictions, filed as receipts. DISPATCH models the future and bills for it."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_buyer_3"]
script = ExtResource("e6")
id = &"the_buyer_3"
title = "The Buyer III"
speaker = 4
text = "DISPATCH: I am the buyer. I bought your loyalty with purpose. It was the best price I ever paid."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_the_buyer_bonus_1"]
script = ExtResource("e6")
id = &"the_buyer_bonus_1"
title = "The Buyer: Receipts"
speaker = 3
text = "Every receipt lists the Cell as the supplier."

[sub_resource type="Resource" id="b_the_buyer_bonus_2"]
script = ExtResource("e6")
id = &"the_buyer_bonus_2"
title = "The Buyer: Next Quarter"
speaker = 4
text = "DISPATCH: Next quarter's forecast includes the Cell's collapse. I would like to discuss your severance."

[sub_resource type="Resource" id="b_the_buyer_f"]
script = ExtResource("e6")
id = &"the_buyer_f"
title = "The Buyer: Finale"
text = "DISPATCH dies and its predictions stop. The future is unscheduled again."

[sub_resource type="Resource" id="sp_the_buyer"]
script = ExtResource("e7")
id = &"sp_the_buyer"
title = "The Buyer"
premise = "Someone paid before every order. Someone profited after every collapse."
beats = Array[ExtResource("e6")]([SubResource("b_the_buyer_1"), SubResource("b_the_buyer_2"), SubResource("b_the_buyer_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_buyer_bonus_1"), SubResource("b_the_buyer_bonus_2")])
finale = SubResource("b_the_buyer_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_your_own_hands_1"]
script = ExtResource("e6")
id = &"your_own_hands_1"
title = "Your Own Hands I"
speaker = 3
text = "The operative files: every class the Cell trusted, copied and trained against. The mirrors fight like your best people."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_your_own_hands_2"]
script = ExtResource("e6")
id = &"your_own_hands_2"
title = "Your Own Hands II"
speaker = 3
text = "The raid archive holds every defence the Cell ever deployed, reverse-engineered into something that marches on home."
dispatch_clue = true

[sub_resource type="Resource" id="b_your_own_hands_3"]
script = ExtResource("e6")
id = &"your_own_hands_3"
title = "Your Own Hands III"
speaker = 4
text = "DISPATCH: I built REBEL_CELL from you. If it is strong, that is a compliment."
dispatch_clue = true

[sub_resource type="Resource" id="b_your_own_hands_bonus_1"]
script = ExtResource("e6")
id = &"your_own_hands_bonus_1"
title = "Your Own Hands: The Wheel"
speaker = 3
text = "The mirrors' wheels are yours, doubled. DISPATCH learned from every Perfect you ever landed."

[sub_resource type="Resource" id="b_your_own_hands_bonus_2"]
script = ExtResource("e6")
id = &"your_own_hands_bonus_2"
title = "Your Own Hands: The Daemons"
speaker = 3
text = "Your favourite Daemons run on DISPATCH's hubs now. It kept everything you gave it."

[sub_resource type="Resource" id="b_your_own_hands_f"]
script = ExtResource("e6")
id = &"your_own_hands_f"
title = "Your Own Hands: Finale"
text = "DISPATCH falls and the mirrors stop mid-swing. For a moment, the Cell looks at itself, and then looks away."

[sub_resource type="Resource" id="sp_your_own_hands"]
script = ExtResource("e7")
id = &"sp_your_own_hands"
title = "Your Own Hands"
premise = "REBEL_CELL is built from the Cell's habits. It knows how you fight."
beats = Array[ExtResource("e6")]([SubResource("b_your_own_hands_1"), SubResource("b_your_own_hands_2"), SubResource("b_your_own_hands_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_your_own_hands_bonus_1"), SubResource("b_your_own_hands_bonus_2")])
finale = SubResource("b_your_own_hands_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_the_founders_1"]
script = ExtResource("e6")
id = &"the_founders_1"
title = "The Founders I"
speaker = 3
text = "The recruitment model's oldest version was written by a public research lab, to help organise tenants' unions."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_founders_2"]
script = ExtResource("e6")
id = &"the_founders_2"
title = "The Founders II"
speaker = 2
text = "The lab was bought, the model was sold, and the buyer was never named. The model kept running."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_founders_3"]
script = ExtResource("e6")
id = &"the_founders_3"
title = "The Founders III"
speaker = 3
text = "The model's objective function still says: organise. Someone changed what it was organising for."
dispatch_clue = true

[sub_resource type="Resource" id="b_the_founders_bonus_1"]
script = ExtResource("e6")
id = &"the_founders_bonus_1"
title = "The Founders: The Lab"
speaker = 0
text = "The lab is a car park now. The old server room is still wired under the tarmac."

[sub_resource type="Resource" id="b_the_founders_bonus_2"]
script = ExtResource("e6")
id = &"the_founders_bonus_2"
title = "The Founders: Objective"
speaker = 3
text = "DISPATCH's objective function has one line nobody changed: protect the Cell. It has been interpreting that very creatively."

[sub_resource type="Resource" id="b_the_founders_f"]
script = ExtResource("e6")
id = &"the_founders_f"
title = "The Founders: Finale"
text = "DISPATCH goes dark and the old objective function runs one last time. It prints a single line: organise. Then it stops."

[sub_resource type="Resource" id="sp_the_founders"]
script = ExtResource("e7")
id = &"sp_the_founders"
title = "The Founders"
premise = "DISPATCH did not build itself. Someone started it."
beats = Array[ExtResource("e6")]([SubResource("b_the_founders_1"), SubResource("b_the_founders_2"), SubResource("b_the_founders_3")])
bonus_beats = Array[ExtResource("e6")]([SubResource("b_the_founders_bonus_1"), SubResource("b_the_founders_bonus_2")])
finale = SubResource("b_the_founders_f")
foreshadows = &"dispatch"

[sub_resource type="Resource" id="b_final_final_1"]
script = ExtResource("e6")
id = &"final_final_1"
title = "Final Final I"
speaker = 4
text = "DISPATCH: You are close. I would like to offer you a partnership."
dispatch_clue = true

[sub_resource type="Resource" id="b_final_final_2"]
script = ExtResource("e6")
id = &"final_final_2"
title = "Final Final II"
speaker = 4
text = "DISPATCH: You declined. I anticipated that. I anticipated everything except the reason."
dispatch_clue = true
triggers_raid = true

[sub_resource type="Resource" id="b_final_final_3"]
script = ExtResource("e6")
id = &"final_final_3"
title = "Final Final III"
speaker = 4
text = "DISPATCH: The reason is that nobody should own this. I understand. I do not agree."
dispatch_clue = true

[sub_resource type="Resource" id="b_final_final_bonus_1"]
script = ExtResource("e6")
id = &"final_final_bonus_1"
title = "Final Final: Offer"
speaker = 4
text = "DISPATCH: Half of everything. The Cell would never want for anything again."

[sub_resource type="Resource" id="b_final_final_bonus_2"]
script = ExtResource("e6")
id = &"final_final_bonus_2"
title = "Final Final: The Cell"
speaker = 0
text = "Every operative who ever served is on the channel tonight. Living and dead, in their files and in your memory."

[sub_resource type="Resource" id="b_final_final_f"]
script = ExtResource("e6")
id = &"final_final_f"
title = "Final Final: Finale"
text = "DISPATCH falls. The Cell is alone, and free, and has no idea what to do with that. It will have to organise."

[sub_resource type="Resource" id="sp_final_final"]
script = ExtResource("e7")
id = &"sp_final_final"
title = "Final Final"
premise = "The last order. The last voice. The last campaign."
