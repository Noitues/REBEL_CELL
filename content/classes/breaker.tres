; Breaker (GDD 5.2 / A.1): 60 HP; wheel Crit, Atk, Atk, Atk, Def, Miss; deck of 10;
; Rank 1 installs the x2 / Pierce / - Inner Ring. Slice values are placeholders
; (docs/DECISIONS.md open questions).

[sub_resource type="Resource" id="slot_0"]
script = ExtResource("3")
slice = ExtResource("s_crit")

[sub_resource type="Resource" id="slot_1"]
script = ExtResource("3")
slice = ExtResource("s_atk")

[sub_resource type="Resource" id="slot_4"]
script = ExtResource("3")
slice = ExtResource("s_def")

[sub_resource type="Resource" id="slot_5"]
script = ExtResource("3")
slice = ExtResource("s_miss")

[sub_resource type="Resource" id="wheel"]
script = ExtResource("2")
slice_count = 6
slots = Array[ExtResource("3")]([SubResource("slot_0"), SubResource("slot_1"), SubResource("slot_1"), SubResource("slot_1"), SubResource("slot_4"), SubResource("slot_5")])
hub = ExtResource("hub")
pointer_ticks = PackedInt32Array(0)

[sub_resource type="Resource" id="rank_1"]
script = ExtResource("4")
rank = 1
max_netrun_tier = 2
inner_ring = ExtResource("ring")
station_bonus_multiplier = 1.25

[sub_resource type="Resource" id="rank_2"]
script = ExtResource("4")
rank = 2
max_netrun_tier = 3
hub_upgrade = ExtResource("hub_mk2")
station_bonus_multiplier = 1.5

; Rank 3 (GDD 6.4): segment swap options Corrupt / Anchor / Accelerator / Echo.
[sub_resource type="Resource" id="rank_3"]
script = ExtResource("4")
rank = 3
max_netrun_tier = 4
ring_segment_options = Array[ExtResource("10")]([ExtResource("seg_corrupt"), ExtResource("seg_anchor"), ExtResource("seg_accelerator"), ExtResource("seg_echo")])
station_bonus_multiplier = 2.0

; Station bonus (GDD 5.2): the node's assets +50% damage. Convention: a DEAL_DAMAGE effect
; whose multiplier is the asset damage factor; rank scales the bonus part (1.25 / 1.5 / 2.0).
[sub_resource type="Resource" id="fx_station"]
script = ExtResource("9")
type = 0
target = 0
multiplier = 1.5

[sub_resource type="Resource" id="te_station"]
script = ExtResource("8")
trigger = 12
effects = Array[ExtResource("9")]([SubResource("fx_station")])

[resource]
script = ExtResource("1")
id = &"breaker"
display_name = "Breaker"
description = "Hits hard and spins harder. Perfect landings resolve the slice twice."
starting_wheel = SubResource("wheel")
starting_deck = Array[ExtResource("5")]([ExtResource("c_jolt"), ExtResource("c_jolt"), ExtResource("c_jolt"), ExtResource("c_jolt"), ExtResource("c_brute"), ExtResource("c_brute"), ExtResource("c_fine"), ExtResource("c_fine"), ExtResource("c_flip"), ExtResource("c_over")])
exclusive_cards = Array[ExtResource("5")]([ExtResource("c_over"), ExtResource("c_shatter")])
base_hp = 60
starting_ram = 6
max_ram = 12
ram_regen = 4
free_nudges_per_turn = 1
station_bonus = Array[ExtResource("8")]([SubResource("te_station")])
rank_rewards = Array[ExtResource("4")]([SubResource("rank_1"), SubResource("rank_2"), SubResource("rank_3")])
