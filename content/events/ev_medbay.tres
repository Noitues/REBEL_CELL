; Placeholder Terminal event (M2). EffectType 14 = HEAL, target 0 = SELF.

[sub_resource type="Resource" id="fx_heal"]
script = ExtResource("3")
type = 14
target = 0
amount = 20

[sub_resource type="Resource" id="c_heal"]
script = ExtResource("2")
