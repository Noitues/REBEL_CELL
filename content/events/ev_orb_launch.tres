[gd_resource type="Resource" script_class="TerminalEventData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e2"]

; orbital Terminal event (decision 2026-09-24).

[sub_resource type="Resource" id="fx0_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = -2

[sub_resource type="Resource" id="c0"]
script = ExtResource("e2")
label = "Add a Cell payload (-2 Heat, 15 Cycles)"
result_text = "Something of yours is going up."
cycle_cost = 15
effects = Array[ExtResource("e1")]([SubResource("fx0_0")])

[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = 3

[sub_resource type="Resource" id="fx1_1"]
script = ExtResource("e1")
type = 23
target = 6
amount = 3

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Sabotage the launch (+3 Heat, +3 Schematics banked)"
result_text = "The rocket does not go up. The insurance pays out."
effects = Array[ExtResource("e1")]([SubResource("fx1_0"), SubResource("fx1_1")])

[sub_resource type="Resource" id="c2"]
script = ExtResource("e2")
label = "Walk on"
result_text = "You keep your head down. The sky keeps watching."

[resource]
script = ExtResource("main_script")
id = &"ev_orb_launch"
title = "Launch Window"
speaker = 1
text = "A launch is scheduled in an hour. The payload manifest has room for one more."
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1"), SubResource("c2")])
corporation_id = &"orbital"
