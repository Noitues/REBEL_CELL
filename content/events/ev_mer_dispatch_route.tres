[gd_resource type="Resource" script_class="TerminalEventData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e2"]

; Meridian Terminal event (M8).

[sub_resource type="Resource" id="fx0_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = -2

[sub_resource type="Resource" id="c0"]
script = ExtResource("e2")
label = "Take the route (-2 Heat)"
result_text = "DISPATCH: Acknowledged. You were expected."
effects = Array[ExtResource("e1")]([SubResource("fx0_0")])

[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = 1

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Ignore it (+1 Heat)"
result_text = "DISPATCH: Understood. Proceed on your own schedule."
effects = Array[ExtResource("e1")]([SubResource("fx1_0")])

[resource]
script = ExtResource("main_script")
id = &"ev_mer_dispatch_route"
title = "DISPATCH: Route"
speaker = 4
text = "DISPATCH: Route update received. Your next node is already cleared. Do not ask how."
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1")])
corporation_id = &"meridian"
dispatch_clue = true
