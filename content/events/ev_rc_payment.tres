[gd_resource type="Resource" script_class="TerminalEventData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e2"]

; rebel_cell Terminal event (decision 2026-09-24).

[sub_resource type="Resource" id="fx0_0"]
script = ExtResource("e1")
type = 22
target = 6
amount = 40

[sub_resource type="Resource" id="fx0_1"]
script = ExtResource("e1")
type = 21
target = 6
amount = 3

[sub_resource type="Resource" id="c0"]
script = ExtResource("e2")
label = "Reroute a payment (+40 Cycles, +3 Heat)"
result_text = "DISPATCH notices immediately."
effects = Array[ExtResource("e1")]([SubResource("fx0_0"), SubResource("fx0_1")])

[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = -3

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Freeze the account (-3 Heat, 6 damage)"
result_text = "The account's defences are your defences."
hp_cost = 6
effects = Array[ExtResource("e1")]([SubResource("fx1_0")])

[sub_resource type="Resource" id="c2"]
script = ExtResource("e2")
label = "Walk on"
result_text = "You walk on. DISPATCH notes the direction."

[resource]
script = ExtResource("main_script")
id = &"ev_rc_payment"
title = "Payment Trail"
speaker = 2
text = "A trail of payments from every corporation you broke, all ending in one account."
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1"), SubResource("c2")])
corporation_id = &"rebel_cell"
