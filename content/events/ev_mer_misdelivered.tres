[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Resource" path="res://content/cards/tap_tap.tres" id="e1"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e3"]

; Meridian Terminal event (M8).

[sub_resource type="Resource" id="c0"]
script = ExtResource("e2")
label = "Open it (Card: Tap Tap)"
result_text = "Inside: a precision driver and a note that says SORRY FOR THE DELAY."
reward = ExtResource("e1")

[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e3")
type = 22
target = 6
amount = 15

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Return to sender (+15 Cycles)"
result_text = "Meridian pays a bounty for its own mistakes."
effects = Array[ExtResource("e3")]([SubResource("fx1_0")])

[sub_resource type="Resource" id="c2"]
script = ExtResource("e2")
label = "Walk on"
result_text = "You keep moving. The conveyor does too."

[resource]
script = ExtResource("main_script")
id = &"ev_mer_misdelivered"
title = "Misdelivered Parcel"
speaker = 0
text = "A Meridian parcel lies on a stairwell, addressed to nobody. It is humming."
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1"), SubResource("c2")])
corporation_id = &"meridian"
