[resource]
script = ExtResource("1")
id = &"ev_leash_on_the_floor"
title = "A Leash on the Floor"
speaker = 1
text = "A bricked implant lies in the maintenance corridor, still warm, still logging. A subbie ran out of renewals here. The log wants a signature before it will let go."
