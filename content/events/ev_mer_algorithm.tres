[gd_resource type="Resource" script_class="TerminalEventData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/cards/gear_mesh.tres" id="e2"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e3"]

; Meridian Terminal event (M8).

[sub_resource type="Resource" id="fx0_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = 2

[sub_resource type="Resource" id="c0"]
script = ExtResource("e3")
label = "Accept (Card: Gear Mesh, +2 Heat)"
result_text = "The route is better. The favour is logged."
effects = Array[ExtResource("e1")]([SubResource("fx0_0")])
reward = ExtResource("e2")

[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e1")
type = 14
target = 0
amount = 5

[sub_resource type="Resource" id="c1"]
script = ExtResource("e3")
label = "Decline (heal 5)"
result_text = "It sulks. You feel better."
effects = Array[ExtResource("e1")]([SubResource("fx1_0")])

[sub_resource type="Resource" id="c2"]
script = ExtResource("e3")
label = "Walk on"
result_text = "You keep moving. The conveyor does too."

[resource]
script = ExtResource("main_script")
id = &"ev_mer_algorithm"
title = "The Algorithm"
speaker = 3
text = "A routing algorithm wants to renegotiate. It offers you a better route in exchange for a small favour."
choices = Array[ExtResource("e3")]([SubResource("c0"), SubResource("c1"), SubResource("c2")])
corporation_id = &"meridian"
min_tier = 2
dispatch_clue = true
