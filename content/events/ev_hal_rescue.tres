[gd_resource type="Resource" script_class="TerminalEventData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/terminal_event_data.gd" id="main_script"]
[ext_resource type="Resource" path="res://content/classes/breaker.tres" id="e1"]
[ext_resource type="Script" path="res://scripts/data/event_choice_data.gd" id="e2"]

; Rescue event (GDD 5.4). The reward class is a placeholder: the rescued operative is one of
; the classes already on the roster (NetrunSession._rescue_class).

[sub_resource type="Resource" id="c0"]
script = ExtResource("e2")
label = "Break them out (6 damage): a rescued operative joins the roster"
result_text = "They are shaky, but they are yours."
hp_cost = 6
reward = ExtResource("e1")

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Leave them"
result_text = "You tell yourself someone else will come."

[resource]
script = ExtResource("main_script")
id = &"ev_hal_rescue"
title = "Holding Cell"
speaker = 0
text = "A Halcyon holding cell. The operative inside was booked for loitering near a Rack."
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1")])
corporation_id = &"halcyon"
min_tier = 2
