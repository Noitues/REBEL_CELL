[sub_resource type="Resource" id="s14"]
script = ExtResource("ch")
label = "Spin the Compassion Wheel (2 free nudges; more cost 3 HP or 1 Heat)"
result_text = "The pointer ticks round and settles. A pleasant voice reads out your terms."
event_wheel = SubResource("s13")

[sub_resource type="Resource" id="s15"]
script = ExtResource("fx")
type = 21
target = 6
amount = -1

[sub_resource type="Resource" id="s16"]
script = ExtResource("ch")
label = "Pay the 180 (-40 Cycles, -1 Heat)"
result_text = "The balance clears. Okafor's file closes with a stamped SETTLED. You get a receipt and a stranger's key fob."
