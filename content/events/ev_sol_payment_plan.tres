[sub_resource type="Resource" id="s19"]
script = ExtResource("ch")
label = "Wipe the ledger (+2 Heat; the next fight gains an escort)"
result_text = "The record burps and blanks. Somewhere a collector gets a very confusing morning, and a Collections Agent arrives early."
next_combat_overrides = SubResource("s18")
