[sub_resource type="Resource" id="fx1_0"]
script = ExtResource("e1")
type = 21
target = 6
amount = 1

[sub_resource type="Resource" id="fx1_1"]
script = ExtResource("e1")
type = 23
target = 6
amount = 2

[sub_resource type="Resource" id="c1"]
script = ExtResource("e2")
label = "Report the clerk (+1 Heat, +2 Schematics banked)"
result_text = "Meridian rewards snitches, and remembers them."
effects = Array[ExtResource("e1")]([SubResource("fx1_0"), SubResource("fx1_1")])

[sub_resource type="Resource" id="c2"]
script = ExtResource("e2")
label = "Walk on"
result_text = "You keep moving. The conveyor does too."

[resource]
script = ExtResource("main_script")
id = &"ev_mer_customs_bribe"
title = "Customs Bribe"
speaker = 2
text = "A Meridian customs clerk leans in. 'For twenty, your traffic is a diplomatic pouch.'"
choices = Array[ExtResource("e2")]([SubResource("c0"), SubResource("c1"), SubResource("c2")])
corporation_id = &"meridian"
