[gd_resource type="Resource" script_class="RaidData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/raid_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/threat_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/threats/courier.tres" id="e2"]
[ext_resource type="Resource" path="res://content/threats/customs_agent.tres" id="e3"]
[ext_resource type="Resource" path="res://content/threats/hauler.tres" id="e4"]
[ext_resource type="Resource" path="res://content/threats/lockdown_unit.tres" id="e5"]
[ext_resource type="Script" path="res://scripts/data/raid_wave_data.gd" id="e6"]

; Meridian raid (M8). replaces = the shared Heat-threshold raid it stands in for.

[sub_resource type="Resource" id="wave0"]
script = ExtResource("e6")
threats = Array[ExtResource("e1")]([ExtResource("e2"), ExtResource("e3"), ExtResource("e4"), ExtResource("e5")])

[resource]
script = ExtResource("main_script")
id = &"raid_mer_heat_75"
display_name = "Freight Seizure"
trigger_source = 0
waves = Array[ExtResource("e6")]([SubResource("wave0")])
schematic_reward = 18
warning_text = "Meridian is seizing freight in your district. Haulers are rolling."
corporation_id = &"meridian"
replaces = &"raid_heat_75"
