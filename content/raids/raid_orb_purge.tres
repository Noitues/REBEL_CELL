[gd_resource type="Resource" script_class="RaidData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/raid_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/threat_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/threats/lander.tres" id="e2"]
[ext_resource type="Resource" path="res://content/threats/signal_jammer.tres" id="e3"]
[ext_resource type="Resource" path="res://content/threats/debris_field.tres" id="e4"]
[ext_resource type="Script" path="res://scripts/data/raid_wave_data.gd" id="e5"]

; orbital raid (decision 2026-09-24).

[sub_resource type="Resource" id="wave0"]
script = ExtResource("e5")
threats = Array[ExtResource("e1")]([ExtResource("e2"), ExtResource("e2"), ExtResource("e3"), ExtResource("e4"), ExtResource("e3"), ExtResource("e4")])

[resource]
script = ExtResource("main_script")
id = &"raid_orb_purge"
display_name = "Kessler Event"
trigger_source = 0
waves = Array[ExtResource("e5")]([SubResource("wave0")])
schematic_reward = 25
warning_text = "Orbital Commons is clearing your orbit. Everything it has is falling on you."
corporation_id = &"orbital"
replaces = &"raid_purge"
