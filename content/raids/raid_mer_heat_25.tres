[gd_resource type="Resource" script_class="RaidData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/data/raid_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/threat_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/threats/courier.tres" id="e2"]
[ext_resource type="Script" path="res://scripts/data/raid_wave_data.gd" id="e3"]

; Meridian raid (M8). replaces = the shared Heat-threshold raid it stands in for.

[sub_resource type="Resource" id="wave0"]
script = ExtResource("e3")
threats = Array[ExtResource("e1")]([ExtResource("e2"), ExtResource("e2")])

[resource]
script = ExtResource("main_script")
id = &"raid_mer_heat_25"
display_name = "Delivery Exception"
trigger_source = 0
waves = Array[ExtResource("e3")]([SubResource("wave0")])
schematic_reward = 8
warning_text = "Meridian has flagged a delivery exception at your address. Two Couriers inbound."
corporation_id = &"meridian"
replaces = &"raid_heat_25"
