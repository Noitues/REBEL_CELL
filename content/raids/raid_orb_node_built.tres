[ext_resource type="Script" path="res://scripts/data/threat_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/threats/debris_field.tres" id="e2"]
[ext_resource type="Script" path="res://scripts/data/raid_wave_data.gd" id="e3"]

; orbital raid (decision 2026-09-24).

[sub_resource type="Resource" id="wave0"]
script = ExtResource("e3")
