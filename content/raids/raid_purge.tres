threats = Array[ExtResource("3")]([ExtResource("th_auditor"), ExtResource("th_enforcer")])

[resource]
script = ExtResource("1")
id = &"raid_purge"
display_name = "Collections: Purge"
trigger_source = 0
waves = Array[ExtResource("2")]([SubResource("wave1"), SubResource("wave2")])
