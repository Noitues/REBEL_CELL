[gd_resource type="Resource" script_class="RaidData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/raid_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/threat_data.gd" id="e1"]
[ext_resource type="Resource" path="res://content/threats/courier.tres" id="e2"]
[ext_resource type="Resource" path="res://content/threats/customs_agent.tres" id="e3"]
[ext_resource type="Script" path="res://scripts/data/raid_wave_data.gd" id="e4"]

; Meridian raid (M8). replaces = the shared Heat-threshold raid it stands in for.

[sub_resource type="Resource" id="wave0"]
script = ExtResource("e4")
threats = Array[ExtResource("e1")]([ExtResource("e2"), ExtResource("e2"), ExtResource("e3")])

[resource]
script = ExtResource("main_script")
id = &"raid_mer_heat_50"
display_name = "Route Audit"
trigger_source = 0
waves = Array[ExtResource("e4")]([SubResource("wave0")])
schematic_reward = 12
warning_text = "A Meridian route audit is sweeping your links. Couriers and a Customs Agent inbound."
corporation_id = &"meridian"
replaces = &"raid_heat_50"
