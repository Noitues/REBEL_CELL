[gd_resource type="Resource" script_class="HomeServerVariantData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/home_server_variant_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/network_node_data.gd" id="2"]

; Standard home server (GDD 3.1-3.2): integrity 50, two asset slots, no internal nodes
; in the slice. NetworkNodeType 0 = HOME_SERVER.

[sub_resource type="Resource" id="home_server"]
script = ExtResource("2")
id = &"home_server"
node_type = 0
display_name = "Home Server"
description = "Lose the campaign if it reaches 0."
install_cost = 0
integrity = 50
asset_slots = 2

[resource]
script = ExtResource("1")
id = &"home_standard"
display_name = "Standard home server"
description = "The default home server layout."
core = SubResource("home_server")
