[gd_resource type="Resource" script_class="HubCoreData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/hub_core_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/triggered_effect_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e2"]

; Ghost Core (GDD 5.2).

[sub_resource type="Resource" id="fx_strip"]
script = ExtResource("e2")
type = 10
target = 3
amount = -2

[sub_resource type="Resource" id="fx_retrigger"]
script = ExtResource("e2")
type = 19
target = 0
multiplier = 1.0

[sub_resource type="Resource" id="hook"]
script = ExtResource("e1")
trigger = 6
min_tier = 2
effects = Array[ExtResource("e2")]([SubResource("fx_strip"), SubResource("fx_retrigger")])

[resource]
script = ExtResource("main_script")
id = &"ghost_core"
display_name = "Ghost Core"
description = "First nudge on an enemy wheel each turn ignores resistance. Perfect: strip 2 resistance and the slice resolves twice."
perfect_hook = SubResource("hook")
free_resistance_nudges = 1
