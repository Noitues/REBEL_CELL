; Breaker Core Mk2, the Rank 2 Hub upgrade (GDD 5.3; numbers made up per the designer
; ruling 2026-09-24): +2 spin on all cards; Perfect: the slice resolves twice and each
; resolution refunds 1 RAM.

[sub_resource type="Resource" id="fx_spin_bonus"]
script = ExtResource("3")
type = 6
target = 1
ring_scope = 2
amount = 2

[sub_resource type="Resource" id="te_spin_bonus"]
script = ExtResource("2")
trigger = 0
effects = Array[ExtResource("3")]([SubResource("fx_spin_bonus")])

[sub_resource type="Resource" id="fx_retrigger"]
