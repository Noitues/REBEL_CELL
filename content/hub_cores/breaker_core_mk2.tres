trigger = 6
min_tier = 2
effects = Array[ExtResource("3")]([SubResource("fx_retrigger"), SubResource("fx_ram")])

[resource]
script = ExtResource("1")
id = &"breaker_core_mk2"
display_name = "Breaker Core Mk2"
description = "+2 spin on all cards. Perfect: the slice resolves twice and refunds RAM."
