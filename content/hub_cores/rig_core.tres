[gd_resource type="Resource" script_class="HubCoreData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/hub_core_data.gd" id="main_script"]
[ext_resource type="Script" path="res://scripts/data/triggered_effect_data.gd" id="e1"]
[ext_resource type="Script" path="res://scripts/data/effect_data.gd" id="e2"]
[ext_resource type="Script" path="res://scripts/core/handlers/calibrate_handler.gd" id="e3"]

; Rig Core (GDD 5.2). The free nudge reuses the Calibrate handler (amount = free nudges).

[sub_resource type="Resource" id="fx_retrigger"]
script = ExtResource("e2")
type = 19
target = 0
multiplier = 0.5

[sub_resource type="Resource" id="fx_ram"]
script = ExtResource("e2")
type = 12
target = 0
amount = 1

[sub_resource type="Resource" id="fx_nudge"]
script = ExtResource("e2")
type = 24
target = 0
amount = 1
custom_handler = ExtResource("e3")

[sub_resource type="Resource" id="hook"]
script = ExtResource("e1")
trigger = 6
min_tier = 2
effects = Array[ExtResource("e2")]([SubResource("fx_retrigger"), SubResource("fx_ram"), SubResource("fx_nudge")])

[resource]
script = ExtResource("main_script")
id = &"rig_core"
display_name = "Rig Core"
description = "+1 max RAM. Perfect: the slice resolves again at half; on each resolution, refund 1 RAM and gain a free nudge."
perfect_hook = SubResource("hook")
max_ram_bonus = 1
