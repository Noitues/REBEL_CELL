class_name StreetR2ConfigData
extends Resource
## Street look parity (P2-P4 step 1): every number of the plate's street rules (art-pass `street_r2/r2_config.py`, ported), plus the
## table constants of the ported facade kits and sign textures. The shipped values live in `content/config/street_r2.tres`,
## generated by `tools/netrun_art/gen_street_r2_config.py` so the Python port and the GDScript twin (`scripts/netrun_art/street_r2_*.gd`)
## read one copy. Each rule field is named after its rule with the dot as an underscore (`frontage.silhouette` = `frontage_silhouette`).
## Read-only at runtime.

## Where the shipped config lives.
const CONFIG_PATH := "res://content/config/street_r2.tres"

static var _shipped: StreetR2ConfigData = null

## Rank 1: the rhythm of heights, crowns, route-sign floors, sightline, the lit silhouette (roof rim, bands, corners).
@export var frontage_silhouette: Dictionary = {}
## Rank 9: backdrop spikes (count, height factor, spacing, landing band, minimum footprint).
@export var horizon_break: Dictionary = {}
## Rank 11: facade kits per district (weights), kit radius, roof clutter kinds.
@export var materials_mix: Dictionary = {}
## Rank 12: the repetition guard and the per-building facade rhythm (bays, floors, modules, setbacks, balconies).
@export var repetition_guard: Dictionary = {}
## Facade props (AC units, pipes, awnings, small signs, lit rooms) and their keep-clear margin for route-room openings.
@export var props_facade: Dictionary = {}
## Rank 2: signs by rule (hero, secondary, shop, backdrop, roof boards) and their emission.
@export var dressing_signs: Dictionary = {}
## LOD tiers of signs by camera distance (BU).
@export var lod_signs: Dictionary = {}
## Rank 4: kerb lamps, lanes, section spill, facade wash.
@export var streets_light: Dictionary = {}
## Rank 7: foreground band, section fill, streak lanes.
@export var foreground_street: Dictionary = {}
## Rank 6: haze, plumes, planes.
@export var atmosphere_layers: Dictionary = {}
## Rank 5: district hues and sign palettes (key "" = the neutral district).
@export var palette_districts: Dictionary = {}
## Art seeds of the plate stills (`s1`, `s2`).
@export var seeds: Dictionary = {}
## Words per district for the sign library (dressing only; "" = the default list).
@export var words: Dictionary = {}
## Sub-line words of the sign library.
@export var subs: Array = []
## Ad plate names (`hero` per district, `board`).
@export var ads: Dictionary = {}
## The one-city frame (lot size, model centre, `kh`, floor pitch, frontage band, extension, frame size).
@export var onecity: Dictionary = {}
## Facade kit tables: cell widths per kit and module, glass / metal / aircraft-light colours, the fall-back window colours.
@export var kits: Dictionary = {}
## Sign texture constants: long side in pixels, the font-fit search range, the pale ink.
@export var sign_tex: Dictionary = {}

## Keys each field must hold (what the twin reads).
const REQUIRED: Dictionary = {
	"frontage_silhouette": ["frontage_min_floors", "floors_low", "floors_mid", "floors_tall", "rhythm_p", "height_step_min", "triple_span_min",
		"crown_share", "crown_kinds", "route_sign_floors", "sightline_floors", "sightline_pad", "roof_rim", "band_gap_p", "band_every", "p_corner"],
	"horizon_break": ["spikes_min", "spikes_max", "spike_k", "spike_spacing", "spike_top", "backdrop_band", "spike_min_w"],
	"materials_mix": ["kits", "kit_radius", "district_weights"],
	"repetition_guard": ["max_same_module_adjacent", "bay_mults", "motif_len", "bay_jitter", "feature_bay_p", "floor_mults", "p_double", "double_mult",
		"ground_mult", "top_mult", "band_floors", "window_tone_pool", "window_tones", "cell_tone", "cell_relief", "p_mixed_modules", "p_setback",
		"setback_min_floors", "setback_from", "setback_depth", "p_balcony_floor", "balcony_w", "balcony_depth"],
	"props_facade": ["density", "p_quiet", "quiet_k", "min_per_face", "max_per_face", "kinds", "opening_margin", "second_row_band", "lamp_shift_max"],
	"dressing_signs": ["hero_kinds", "hero_central_frac", "p_secondary", "p_shop_sign", "signs_on_screen_min", "legible_px",
		"backdrop_sign_p", "p_roof_board", "sign_off", "hero_emit", "sec_emit", "shop_emit", "backdrop_emit"],
	"lod_signs": ["t1_shape", "t2_full", "t3_detail", "fade_margin"],
	"streets_light": ["lamp_step", "lamp_jit", "lamp_post_h", "kerb_off"],
	"foreground_street": ["fg_lanes"],
	"atmosphere_layers": ["plumes", "plume_h", "plume_r"],
	"palette_districts": ["hues", "sign_pal"],
	"onecity": ["u", "cx", "cy", "kh", "floor_bu", "front_band", "min_width", "extend", "w", "h"],
	"kits": ["kit_w", "glass_col", "metal_col", "win_cols", "red"],
	"sign_tex": ["long_px", "long_px_big", "fit_lo", "fit_hi", "pale", "min_px"],
	"ads": ["hero", "board"],
}


## Problems of this config: a missing key, an empty word list, a kit without a width row. Empty when sound.
func validate() -> PackedStringArray:
	var errs := PackedStringArray()
	for field: String in REQUIRED:
		var d: Dictionary = get(field)
		for key: String in REQUIRED[field]:
			if not d.has(key):
				errs.append("%s.%s missing" % [field, key])
	if not words.has(""):
		errs.append("words needs the default list under the key \"\"")
	for district: String in words:
		if (words[district] as Array).is_empty():
			errs.append("words.%s is empty" % district)
	if subs.is_empty():
		errs.append("subs is empty")
	var sp: Dictionary = palette_districts.get("sign_pal", {})
	if not sp.has(""):
		errs.append("palette_districts.sign_pal needs the neutral palette under the key \"\"")
	var kw: Dictionary = kits.get("kit_w", {})
	for kit: String in ["glass_curtain", "panel_grille", "lit_atrium"]:
		if not kw.has(kit) or (kw[kit] as Array).size() != 3:
			errs.append("kits.kit_w.%s needs three cell widths" % kit)
	var dw: Dictionary = materials_mix.get("district_weights", {})
	if not dw.has(""):
		errs.append("materials_mix.district_weights needs the neutral row under the key \"\"")
	for district: String in dw:
		if (dw[district] as Array).size() != (materials_mix.get("kits", []) as Array).size():
			errs.append("materials_mix.district_weights.%s needs one weight per kit" % district)
	return errs


## The shipped config (loaded once, then cached).
static func shipped() -> StreetR2ConfigData:
	if _shipped == null:
		_shipped = load(CONFIG_PATH) as StreetR2ConfigData
	return _shipped
